        <PAGEOBJECT XPOS="737.796275590551" YPOS="5674.17422834647" OwnPage="12" ItemID="383641409" PTYPE="2" WIDTH="45.3543307086614" HEIGHT="48.1889763779528" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="0.05137417524302" LOCALSCY="0.05137417524302" LOCALX="0" LOCALY="0" LOCALROT="360" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="../../../Plateau/Battlelore of the Ring/hexagone_riviere.png" PRFILE="Embedded GIMP built-in sRGB" IRENDER="0" EPROF="Embedded GIMP built-in sRGB" path="M0 0 L45.3543 0 L45.3543 48.189 L0 48.189 L0 0 Z" copath="M0 0 L45.3543 0 L45.3543 48.189 L0 48.189 L0 0 Z" gXpos="737.796275590551" gYpos="5674.17422834648" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="737.796275590551" YPOS="5749.29233858268" OwnPage="12" ItemID="383638577" PTYPE="2" WIDTH="45.3543307086614" HEIGHT="48.1889763779528" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="0.05137417524302" LOCALSCY="0.05137417524302" LOCALX="0" LOCALY="0" LOCALROT="360" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="../../../Plateau/Battlelore of the Ring/hexagone_gue.png" PRFILE="Embedded GIMP built-in sRGB" IRENDER="0" EPROF="Embedded GIMP built-in sRGB" path="M0 0 L45.3543 0 L45.3543 48.189 L0 48.189 L0 0 Z" copath="M0 0 L45.3543 0 L45.3543 48.189 L0 48.189 L0 0 Z" gXpos="737.796275590551" gYpos="5749.29233858269" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="737.796275590551" YPOS="5824.41044881893" OwnPage="12" ItemID="383644241" PTYPE="2" WIDTH="45.3543307086614" HEIGHT="48.1889763779528" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="0.0359083281504864" LOCALSCY="0.0359083281504864" LOCALX="0" LOCALY="0" LOCALROT="360" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="../06 - Images/hexagone_pont.png" PRFILE="sRGB display profile (ICC v2.2)" IRENDER="0" EMBEDDED="0" path="M0 0 L45.3543 0 L45.3543 48.189 L0 48.189 L0 0 Z" copath="M0 0 L45.3543 0 L45.3543 48.189 L0 48.189 L0 0 Z" gXpos="737.796275590551" gYpos="5824.41044881893" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="737.796275590551" YPOS="5899.52855905512" OwnPage="12" ItemID="383658401" PTYPE="2" WIDTH="45.3543307086614" HEIGHT="48.1889763779528" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="0.0359083281504864" LOCALSCY="0.0359083281504864" LOCALX="0" LOCALY="0" LOCALROT="360" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="../06 - Images/hexagone_batiment.png" PRFILE="sRGB display profile (ICC v2.2)" IRENDER="0" EPROF="Embedded sRGB built-in" EMBEDDED="0" path="M0 0 L45.3543 0 L45.3543 48.189 L0 48.189 L0 0 Z" copath="M0 0 L45.3543 0 L45.3543 48.189 L0 48.189 L0 0 Z" gXpos="737.796275590551" gYpos="5899.52855905513" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="985.827771653543" YPOS="5818.74115748032" OwnPage="12" ItemID="383661233" PTYPE="4" WIDTH="233.858267716535" HEIGHT="119.055118110236" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="RVB #c69251" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="5.66929133858268" BEXTRA="5.66929133858268" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L233.858 0 L233.858 119.055 L0 119.055 L0 0 Z" copath="M0 0 L233.858 0 L233.858 119.055 L0 119.055 L0 0 Z" gXpos="985.827771653543" gYpos="5818.74115748032" gWidth="0" gHeight="0" PSTYLE="Exemple" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Exemple"/>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="Exemple"/>
                <para PARENT="Exemple"/>
                <ITEXT CH="Des Ar­chers de Mi­nas Ti­rith "/>
                <ITEXT Unicode="25" COBJ="783"/>
                <ITEXT CH=" tiennent un bos­quet. Des Gardes ser­pents "/>
                <ITEXT Unicode="25" COBJ="27704"/>
                <ITEXT CH=" les at­taquent : leur cible est dans un bois, ils lancent 2 dés au lieu de 3. Si la carte qui les a ac­ti­vés donne 1 dé de plus en com­bat, ils en lancent 3. Les ar­chers sur­vivent et ri­postent avec leurs 2 dés ha­bi­tuels."/>
                <trail PARENT="Exemple"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="985.827771653543" YPOS="5946.30021259843" OwnPage="12" ItemID="383664065" PTYPE="4" WIDTH="233.858267716535" HEIGHT="59.5275590551181" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="RVB #374317" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="5.66929133858268" BEXTRA="5.66929133858268" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L233.858 0 L233.858 59.5276 L0 59.5276 L0 0 Z" copath="M0 0 L233.858 0 L233.858 59.5276 L0 59.5276 L0 0 Z" gXpos="985.827771653543" gYpos="5946.30021259843" gWidth="0" gHeight="0" PSTYLE="A retenir" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="A retenir"/>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="À re­te­nir"/>
                <para PARENT="A retenir"/>
                <ITEXT CH="Bois, gué et bâ­ti­ment ar­rêtent l'uni­té qui y entre ; bois, col­line et bâ­ti­ment bloquent la vue."/>
                <trail PARENT="A retenir"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="986.741157480315" YPOS="6015.04824409451" OwnPage="12" ItemID="383652737" PTYPE="2" WIDTH="233.858267716535" HEIGHT="30.4497637795276" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="0.094297688595377" LOCALSCY="0.094297688595377" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="../06 - Images/charte/separateur_08_300dpi.png" PRFILE="sRGB display profile (ICC v2.2)" IRENDER="0" EMBEDDED="0" path="M0 0 L233.858 0 L233.858 30.4498 L0 30.4498 L0 0 Z" copath="M0 0 L233.858 0 L233.858 30.4498 L0 30.4498 L0 0 Z" ImageRes="0" gXpos="2177.29233858267" gYpos="1605.59942519683" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="170.867141732283" YPOS="6264.09548818898" OwnPage="13" ItemID="383666897" PTYPE="4" WIDTH="481.889763779528" HEIGHT="680.314960629921" FRTYPE="3" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="14.1732283464567" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L481.89 0 L481.89 553.075 L245.487 553.075 L245.487 680.315 L0 680.315 L0 0 Z" copath="M0 0 L481.89 0 L481.89 680.315 L0 680.315 L0 0 Z" gXpos="170.867141732283" gYpos="6264.09548818898" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="383655569" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="9. Lea­ders, Gé­né­raux et Des­tin"/>
                <para PARENT="Titre 1"/>
                <ITEXT CH="Les grands noms du Sei­gneur des An­neaux ne com­battent pas seuls : cha­cun mène une uni­té. Ara­gorn marche avec la Com­pa­gnie Grise, Im­ra­hil che­vauche en tête de ses che­va­liers. Ce sont les Lea­ders."/>
                <para/>
                <ITEXT CH="Le Lea­der"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Un Lea­der est un per­son­nage nom­mé qui mène une uni­té. Sa fi­gu­rine fait par­tie de l'uni­té, et un je­ton de badge d'uni­té "/>
                <ITEXT Unicode="25" COBJ="30882"/>
                <ITEXT CH=" po­sé à cô­té d'elle le si­gnale sur le champ de ba­taille. Un Lea­der peut me­ner n'im­porte quelle uni­té de son peuple. Quelques uni­tés, comme la Com­pa­gnie Grise avec Ara­gorn, in­cluent leur Lea­der dans leur pro­fil."/>
                <para/>
                <ITEXT CH="Un Lea­der donne les avan­tages sui­vants à son uni­té :"/>
                <para/>
                <ITEXT CH="Au com­bat, l'uni­té touche éga­le­ment sur "/>
                <ITEXT Unicode="25" COBJ="26801"/>
                <ITEXT CH=" Cou­ronne, que ce soit en at­taque ou quand elle ri­poste (cha­pitre 7)."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Si l'uni­té porte"/>
                <ITEXT FONT="Alegreya Sans Bold" CH=" [Ar­mure]"/>
                <ITEXT CH=", chaque Cou­ronne an­nule une touche, comme une face Pou­voir (cha­pitre 7)."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="L'uni­té et chaque uni­té amie ad­ja­cente gagnent "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[In­ébran­lable 1]"/>
                <ITEXT CH=" : elles peuvent igno­rer 1 Dra­peau à chaque at­taque qu'elles su­bissent (cha­pitre 7)."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Quand son uni­té perd des fi­gu­rines, celle du Lea­der est tou­jours re­ti­rée en der­nier. Une uni­té n'est ja­mais me­née par plus d'un Lea­der."/>
                <para/>
                <ITEXT CH="Le Gé­né­ral"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Cer­tains Lea­ders sont aus­si des Gé­né­raux : leur pro­fil l'in­dique. Un Gé­né­ral com­mande au-de­là de son uni­té. Tant qu'il est en jeu, la main de son camp compte 1 carte de plus (cha­pitre 5)."/>
                <para/>
                <ITEXT CH="Quand un Gé­né­ral est éli­mi­né, son camp dé­fausse aus­si­tôt une carte de sa main, à son choix, même pen­dant le tour ad­verse. La main compte dé­sor­mais une carte de moins."/>
                <para/>
                <ITEXT CH="Le for­mat li­mite le nombre de Gé­né­raux qu'un camp peut ali­gner : 2 en Es­car­mouche, 3 en Nor­mal, sans li­mite en Épique."/>
                <para/>
                <ITEXT CH="Le Des­tin"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Chaque Lea­der a une va­leur de Des­tin, de 1 à 4, in­di­quée sur son pro­fil. Elle lui laisse une chance de sur­vivre à son uni­té."/>
                <para/>
                <ITEXT CH="Quand une uni­té me­née par un Lea­der est mise en dé­route, l'ad­ver­saire marque son point de vic­toire comme d'ha­bi­tude. Puis le Lea­der tente de re­joindre une autre uni­té :"/>
                <para/>
                <ITEXT CH="Choi­sis­sez une uni­té de re­pli. Il faut une uni­té amie de son peuple, sans Lea­der, à 3 hexa­gones ou moins de l'hexa­gone qu'oc­cu­pait son uni­té. S'il n'y en a au­cune, le Lea­der est éli­mi­né, sans jet."/>
                <para PARENT="Liste numérotée sans suivi"/>
                <ITEXT CH="Lan­cez au­tant de dés que sa va­leur de Des­tin. Ces dés ne rap­portent pas de Pou­voir."/>
                <para PARENT="Liste numérotée sans suivi"/>
                <ITEXT CH="Si au moins une "/>
                <ITEXT Unicode="25" COBJ="25283"/>
                <ITEXT CH=" Cou­ronne est ob­te­nue : il est sau­vé. Il re­joint l'uni­té de votre choix par­mi les uni­tés de re­pli pos­sibles, et sa va­leur de Des­tin baisse de 1 pour le reste de la par­tie. Sans Cou­ronne, il est éli­mi­né."/>
                <para PARENT="Liste numérotée sans suivi"/>
                <ITEXT CH="Le Lea­der sau­vé prend la place d'une fi­gu­rine or­di­naire de l'uni­té qui l'ac­cueille : re­ti­rez-en une et po­sez la sienne. L'uni­té ne gagne au­cun PV. Po­sez le je­ton "/>
                <ITEXT Unicode="25" COBJ="16810"/>
                <ITEXT CH=" à cô­té d'elle. Sur un Char ou une Créa­ture, seul le je­ton change de place."/>
                <para/>
                <ITEXT CH="Un Lea­der dont le Des­tin tombe à 0 n'a plus de jet : il est éli­mi­né avec sa pro­chaine uni­té. Un Gé­né­ral sau­vé reste en jeu, et la main de son camp ne change pas."/>
                <para/>
                <ITEXT CH="Cer­tains Lea­ders sont uni­ver­sels : leur uni­té de re­pli peut ap­par­te­nir à n'im­porte quel peuple de leur camp. Leur pro­fil le pré­cise."/>
                <para/>
                <ITEXT CH="Un Lea­der éli­mi­né ne rap­porte pas de point de vic­toire : seule compte la dé­route de son uni­té. Le scé­na­rio peut tou­te­fois en faire un ob­jec­tif."/>
                <para/>
                <ITEXT CH="10. Le for­mat Épique et le mode mul­ti-joueurs"/>
                <para PARENT="Titre 1"/>
                <ITEXT CH="Les grandes ba­tailles se jouent en for­mat Épique, sur un champ de ba­taille de 17 × 13 hexa­gones. Comme les autres for­mats, il se joue à deux, un joueur par camp. Il peut aus­si se jouer à six, trois joueurs par camp : c'est le mode mul­ti-joueurs, qui reste op­tion­nel."/>
                <para/>
                <ITEXT CH="Le râ­te­lier, la fa­çon de jouer ses cartes et l'adap­ta­tion des cartes Tac­tiques valent pour toute par­tie Épique. Les trois der­nières sec­tions ne concernent que le mode mul­ti-joueurs."/>
                <para/>
                <ITEXT CH="Le râ­te­lier"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Le râ­te­lier est une ran­gée de 3 cartes de com­man­de­ment, po­sée face vi­sible à cô­té de la pioche et com­mune aux deux camps. Avant le pre­mier tour, re­tour­nez-y les 3 pre­mières cartes de la pioche."/>
                <para/>
                <ITEXT CH="Jouer ses cartes"/>
                <para PARENT="Titre 2"/>
                <ITEXT KERN="-1" CH="À l'étape de com­man­de­ment, votre camp joue au choix :"/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="jus­qu'à 2 cartes de sec­tion"/>
                <ITEXT CH=", dont une au plus de sa main et une au plus du râ­te­lier ;"/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="ou une seule carte Tac­tique"/>
                <ITEXT CH=", de sa main ou du râ­te­lier."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Un camp ne joue ja­mais une carte de sec­tion et une carte Tac­tique dans le même tour, ni deux cartes Tac­tiques."/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="La va­leur de com­man­de­ment"/>
                <ITEXT CH=" reste le nombre de cartes dans la main du camp. Les cartes du râ­te­lier n'y comptent ja­mais, même celle que vous jouez."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Re­pio­cher."/>
                <ITEXT CH=" À l'étape de pioche, chaque carte jouée est rem­pla­cée là d'où elle vient : pio­chez une carte pour votre main si vous avez joué une carte de votre main, et re­tour­nez une carte de la pioche dans le râ­te­lier si vous en avez pris une. Le râ­te­lier compte tou­jours 3 cartes. Un cas rare de mise à jour est trai­té dans le li­vret de ré­fé­rence (voir Râ­te­lier)."/>
                <para/>
                <ITEXT KERN="-5" CH="Adap­ta­tion des cartes tac­tiques"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Toutes les cartes Tac­tiques s'uti­lisent comme dans les autres for­mats, à l'ex­cep­tion des deux sui­vantes :"/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" KERN="-1" CH="Ordre di­rect"/>
                <ITEXT KERN="-1" CH=" ac­tive 1 uni­té par tranche de 2 cartes dans la main du camp, ar­ron­di au su­pé­rieur : 3 uni­tés avec une main de 5 ou 6 cartes, 4 avec une main de 7 ou 8."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" KERN="-1" CH="Contre-at­taque"/>
                <ITEXT KERN="-1" CH=", quand l'ad­ver­saire vient de jouer 2 cartes de sec­tion, n'en re­prend qu'une, au choix."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Leur texte com­plet fi­gure dans le li­vret de ré­fé­rence."/>
                <para/>
                <ITEXT CH="Un joueur par Sec­tion"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Chaque joueur com­mande une Sec­tion de son camp : Gauche, Centre ou Droite. Il com­mande les uni­tés de son camp qui s'y trouvent au dé­but du tour. Une uni­té qui change de Sec­tion pen­dant le tour reste à son joueur jus­qu'à la fin du tour, puis passe à ce­lui de sa nou­velle Sec­tion. Une uni­té sur un hexa­gone de fron­tière peut être ac­ti­vée par l'un ou l'autre des deux joueurs voi­sins (cha­pitre 2)."/>
                <para/>
                <ITEXT CH="Les cartes de com­man­de­ment en mode mul­ti-joueurs"/>
                <para PARENT="Titre 2"/>
                <ITEXT KERN="-1" CH="Votre camp ne tient qu'une main, comme à deux joueurs : 4 cartes, plus 1 par Gé­né­ral en jeu (cha­pitre 9). C'est le joueur Centre qui la tient. Il la montre à ses deux co­équi­piers, ja­mais à l'ad­ver­saire. Les trois joueurs dis­cutent des cartes à jouer ; le joueur Centre a le der­nier mot."/>
                <para/>
                <ITEXT CH="Une fois les cartes jouées, chaque joueur ac­tive, dé­place et fait com­battre les uni­tés de sa propre Sec­tion. Le joueur Centre choi­sit les cartes, pas les uni­tés de ses co­équi­piers."/>
                <para/>
                <ITEXT CH="Les je­tons Pou­voir en mode mul­ti-joueurs"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="La ré­serve de Pou­voir reste com­mune au camp (cha­pitre 5). Une fois les cartes jouées, chaque joueur peut ache­ter jus­qu'à 2 uni­tés de sa propre Sec­tion : un camp peut donc en ac­ti­ver 6 de plus. Une uni­té sur un hexa­gone de fron­tière peut être ache­tée par l'un ou l'autre de ses deux joueurs. Si les joueurs ne s'en­tendent pas sur l'usage de la ré­serve, le joueur Centre tranche."/>
                <para/>
                <ITEXT KERN="-3" CH="11. Un tour com­men­té"/>
                <para PARENT="Titre 1"/>
                <ITEXT CH="Ce cha­pitre suit un tour com­plet, de la carte jouée à la der­nière pioche. Il n'ap­prend au­cune règle nou­velle : chaque geste ren­voie au cha­pitre qui l'ex­plique. La par­tie se joue en for­mat Nor­mal, à deux joueurs, et c'est au tour du Mal."/>
                <para/>
                <ITEXT CH="La si­tua­tion"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Ce mor­ceau du champ de ba­taille porte une col­line et deux bois. Le scé­na­rio a po­sé une mé­daille ob­jec­tif sur la col­line : à chaque étape des points de vic­toire, elle va au camp qui l'oc­cupe (cha­pitre 4). Pour l'ins­tant, per­sonne ne la tient."/>
                <para/>
                <ITEXT CH="Le Bien tient une ligne. Ses Ar­chers de Mi­nas Ti­rith "/>
                <ITEXT Unicode="25" COBJ="15442"/>
                <ITEXT CH=" sont en avant, avec der­rière eux des Guer­riers de Mi­nas Ti­rith "/>
                <ITEXT Unicode="25" COBJ="15464"/>
                <ITEXT CH=" et des Che­va­liers de Dol Am­roth "/>
                <ITEXT Unicode="25" COBJ="6265"/>
                <ITEXT CH=". Plus loin, face au Centre du Mal, se tiennent des Guer­riers de Los­sar­nach "/>
                <ITEXT Unicode="25" COBJ="28568"/>
                <ITEXT CH=" me­nés par For­long le Gros, un Lea­der. Au­cune uni­té du Bien ne porte de ban­nière ni de badge Fac­tion."/>
                <para/>
                <ITEXT CH="Dans sa Sec­tion Gauche, le Mal aligne une Meute de ca­va­liers wargs "/>
                <ITEXT Unicode="25" COBJ="29506"/>
                <ITEXT CH=", une Bande d'orques du Mor­dor "/>
                <ITEXT Unicode="25" COBJ="27943"/>
                <ITEXT CH=" avec ban­nière et une Bande de pis­teurs orques "/>
                <ITEXT Unicode="25" COBJ="32433"/>
                <ITEXT CH=". Au Centre at­tend une Bande d'uruk-hai "/>
                <ITEXT Unicode="25" COBJ="7890"/>
                <ITEXT CH=", me­née par Goth­mog, Lea­der et Gé­né­ral. Au­cune de ces uni­tés ne porte de badge Fac­tion."/>
                <para/>
                <ITEXT KERN="-2" CH="Goth­mog est le seul Gé­né­ral du Mal : sa main compte 5 cartes (cha­pitre 9). Sa ré­serve contient 6 je­tons de Pou­voir."/>
                <para/>
                <ITEXT CH="1. Com­man­de­ment"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Le Mal a en main "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Pa­trouille Gauche"/>
                <ITEXT CH=", "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Charge de ca­va­le­rie"/>
                <ITEXT CH=", "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Éclai­reur Centre"/>
                <ITEXT CH=", "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="At­taque Droite"/>
                <ITEXT CH=" et "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Ban­nières vertes"/>
                <ITEXT CH=". "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Charge de ca­va­le­rie"/>
                <ITEXT CH=" est ten­tante : elle ac­tive au­tant d'uni­tés de Ca­va­le­rie que sa va­leur de com­man­de­ment, soit 5, car la carte jouée compte dans la main (cha­pitre 5). Mais le Mal n'a ici qu'une uni­té de Ca­va­le­rie, les Wargs. Il garde la carte pour plus tard et joue "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Pa­trouille Gauche"/>
                <ITEXT CH=", qui ac­tive 2 uni­tés de sa Sec­tion Gauche."/>
                <para/>
                <ITEXT KERN="-1" CH="Il dé­pense en­suite sa ré­serve. Une uni­té coûte au­tant de je­tons qu'elle lance de dés : les Pis­teurs "/>
                <ITEXT KERN="-1" Unicode="25" COBJ="28145"/>
                <ITEXT KERN="-1" CH=" lui coûtent 2 je­tons, les Uruk-hai "/>
                <ITEXT KERN="-1" Unicode="25" COBJ="32229"/>
                <ITEXT KERN="-1" CH=" 4. Il a at­teint le maxi­mum de 2 uni­tés ache­tées par tour, et sa ré­serve tomb"/>
                <ITEXT CH="e à 0."/>
                <para/>
                <ITEXT CH="2. Ordre"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Le Mal dé­signe ses 4 uni­tés ac­ti­vées : les Wargs et les Orques pour la carte, les Pis­teurs et les Uruk-hai en dé­pen­sant les je­tons de Pou­voir. Ses autres uni­tés ne bou­ge­ront pas et ne com­bat­tront pas ce tour."/>
                <para/>
                <ITEXT CH="3. Mou­ve­ment"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Le Mal dé­place ses uni­tés une à une, dans l'ordre de son choix (cha­pitre 6)."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" KERN="0" CH="Les Orques"/>
                <ITEXT FONT="Alegreya Sans Regular" KERN="0" CH="  partent les pre­miers"/>
                <ITEXT KERN="0" CH=" et montent sur la col­line, à 1 hexa­gone. La col­line ne freine pas le mou­ve­ment (cha­pitre 8). Les voi­là ad­ja­cents aux Ar­chers, en contre­bas."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" KERN="0" CH="Les Pis­teurs"/>
                <ITEXT FONT="Alegreya Sans Regular" KERN="0" CH=" suivent "/>
                <ITEXT KERN="0" CH="et contournent le bois, en 2 hexa­gones."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" KERN="0" CH="Les Wargs"/>
                <ITEXT KERN="0" CH=", Ca­va­le­rie stan­dard, se dé­placent de 3 hexa­gones et viennent au contact des Ar­chers."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" KERN="0" CH="Les Uruk-hai "/>
                <ITEXT KERN="0" CH="se dé­placent de 1 hexa­gone seule­ment, jus­qu'au contact des Guer­riers de Los­sar­nach. Uni­té rouge, ils ne pour­raient plus at­ta­quer s'ils al­laient plus loin."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="4. At­taque"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Toutes les uni­tés ont bou­gé : le com­bat com­mence. Le Mal choi­sit l'ordre de ses at­taques (cha­pitre 7)."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Les Pis­teurs tirent. "/>
                <ITEXT CH="Leur cible idéale, les Ar­chers, est à 3 hexa­gones, mais la ligne de vue tra­verse la col­line : elle est blo­quée. Les Guer­riers de Mi­nas Ti­rith, à 3 hexa­gones eux aus­si, sont bien en vue. Les Pis­teurs lancent 2 dés : "/>
                <ITEXT Unicode="25" COBJ="18107"/>
                <ITEXT CH=" Arc et "/>
                <ITEXT Unicode="25" COBJ="17575"/>
                <ITEXT CH=" Pou­voir. Une touche : les Guer­riers de Mi­nas Ti­rith perdent 1 fi­gu­rine. Le Pou­voir ne dé­clenche rien, mais il rap­porte 1 je­ton "/>
                <ITEXT Unicode="25" COBJ="21711"/>
                <ITEXT CH=" au Mal. Les Guer­riers de Mi­nas Ti­rith ne sont pas ad­ja­cents aux Pis­teurs : ils ne ri­postent pas. Grâce à "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Mo­bi­li­té 1]"/>
                <ITEXT CH=", les Pis­teurs dé­crochent aus­si­tôt de 1 hexa­gone et entrent dans un bois. Au tour du Bien, toute uni­té qui les at­ta­que­ra lan­ce­ra 2 dés au plus."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Les Orques chargent de­puis la col­line."/>
                <ITEXT CH=" Ils at­taquent les Ar­chers en contre­bas avec 3 dés, plus 1 pour la col­line (cha­pitre 8) : "/>
                <ITEXT Unicode="25" COBJ="2015"/>
                <ITEXT CH=" Épées croi­sées, "/>
                <ITEXT Unicode="25" COBJ="15131"/>
                <ITEXT CH=" Épée, "/>
                <ITEXT Unicode="25" COBJ="3150"/>
                <ITEXT CH=" Cou­ronne, Pou­voir. Deux touches : les Ar­chers perdent 2 fi­gu­rines. La Cou­ronne "/>
                <ITEXT Unicode="25" COBJ="20924"/>
                <ITEXT CH=" ne fait rien sans Lea­der, et le Pou­voir rap­porte 1 je­ton "/>
                <ITEXT Unicode="25" COBJ="24017"/>
                <ITEXT CH=". Les Ar­chers n'ont pas bou­gé : ils ri­postent, car une uni­té de tir peut ti­rer sur une uni­té ad­ja­cente. Leurs 2 dés donnent "/>
                <ITEXT Unicode="25" COBJ="28540"/>
                <ITEXT CH=" Arc et "/>
                <ITEXT Unicode="25" COBJ="9959"/>
                <ITEXT CH=" Dra­peau. Une touche : les Orques perdent 1 fi­gu­rine. Leur ban­nière leur donne "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[In­ébran­lable 1]"/>
                <ITEXT CH=" : ils choi­sissent d'igno­rer le "/>
                <ITEXT Unicode="25" COBJ="18847"/>
                <ITEXT CH=" Dra­peau et res­tent sur la col­line."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Goth­mog frappe For­long."/>
                <ITEXT CH=" Les Uruk-hai lancent 4 dés : "/>
                <ITEXT Unicode="25" COBJ="15065"/>
                <ITEXT CH=" Épées croi­sées, "/>
                <ITEXT Unicode="25" COBJ="8927"/>
                <ITEXT CH=" Cou­ronne , "/>
                <ITEXT Unicode="25" COBJ="20145"/>
                <ITEXT CH=" Dra­peau, "/>
                <ITEXT Unicode="25" COBJ="5013"/>
                <ITEXT CH=" Arc. Grâce à Goth­mog, la Cou­ronne "/>
                <ITEXT Unicode="25" COBJ="17187"/>
                <ITEXT CH=" touche : 2 touches, les Guer­riers de Los­sar­nach perdent 2 fi­gu­rines. La fi­gu­rine de For­long est re­ti­rée en der­nier : il reste en jeu. Il donne"/>
                <ITEXT FONT="Alegreya Sans Bold" CH=" [In­ébran­lable 1] "/>
                <ITEXT CH="à son uni­té, qui choi­sit d'igno­rer le Dra­peau et ri­poste avec ses 3 dés. "/>
                <ITEXT Unicode="25" COBJ="16905"/>
                <ITEXT CH=" Épée, "/>
                <ITEXT Unicode="25" COBJ="17808"/>
                <ITEXT CH=" Épée, "/>
                <ITEXT Unicode="25" COBJ="16063"/>
                <ITEXT CH=" Cou­ronne : 3 touches, car la Cou­ronne "/>
                <ITEXT Unicode="25" COBJ="10358"/>
                <ITEXT CH=" touche aus­si pour For­long. Les Uruk-hai portent"/>
                <ITEXT FONT="Alegreya Sans Bold" CH=" [Ar­mure] "/>
                <ITEXT CH=": ils lancent 1 dé par touche et ob­tiennent "/>
                <ITEXT Unicode="25" COBJ="28748"/>
                <ITEXT CH=" Pou­voir, "/>
                <ITEXT Unicode="25" COBJ="13242"/>
                <ITEXT CH=" Cou­ronne et "/>
                <ITEXT Unicode="25" COBJ="9277"/>
                <ITEXT CH=" Dra­peau. Le Pou­voir an­nule une touche, la Cou­ronne "/>
                <ITEXT Unicode="25" COBJ="14237"/>
                <ITEXT CH=" une autre, parce que Goth­mog mène l'uni­té (cha­pitre 9). Les Uruk-hai perdent 1 fi­gu­rine. Ni la ri­poste ni les dés d'"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Ar­mure]"/>
                <ITEXT CH=" ne rap­portent de jetons Pou­voir "/>
                <ITEXT Unicode="25" COBJ="22508"/>
                <ITEXT CH="."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Les Wargs achèvent les Ar­chers. "/>
                <ITEXT CH="Il ne reste aux Ar­chers que 2 fi­gu­rines. Les Wargs lancent 3 dés : "/>
                <ITEXT Unicode="25" COBJ="12821"/>
                <ITEXT CH=" Épées croi­sées, "/>
                <ITEXT Unicode="25" COBJ="16425"/>
                <ITEXT CH=" Dra­peau, "/>
                <ITEXT Unicode="25" COBJ="21706"/>
                <ITEXT CH=" Arc. Une touche : il reste 1 fi­gu­rine. Le Dra­peau de­vrait faire re­cu­ler les Ar­chers de 1 hexa­gone, mais les deux hexa­gones qui les rap­prochent de leur bord sont oc­cu­pés par les Guer­riers de Mi­nas Ti­rith et les Che­va­liers. Leur re­traite est blo­quée (cha­pitre 7) : ils perdent leur der­nière fi­gu­rine et sont mis en dé­route. Le Mal prend une mé­daille."/>
                <para/>
                <ITEXT KERN="-1" CH="Comme toute Ca­va­le­rie stan­dard de mê­lée, les Wargs portent"/>
                <ITEXT FONT="Alegreya Sans Bold" KERN="-1" CH=" [Pour­suite 2]"/>
                <ITEXT KERN="-1" CH=" (cha­pitre 3). Ils pour­raient s'ar­rê­ter dans l'hexa­gone li­bé­ré, au contact des Che­va­liers, et les at­ta­quer avec leurs 3 dés. Ils pré­fèrent en­trer dans l'hexa­gone li­bé­ré puis dans le bois voi­sin, qui les ar­rête, tou­jours au contact des Che­va­liers. De­puis le bois, ils ne lancent que 2 dés : "/>
                <ITEXT Unicode="25" COBJ="2559"/>
                <ITEXT KERN="-1" CH=" Épées croi­sées et "/>
                <ITEXT Unicode="25" COBJ="29206"/>
                <ITEXT KERN="-1" CH=" Pou­voir. Une touche, et 1 je­ton de Pou­voir de plus pour le Mal. Les Che­va­liers lancent 1 dé d'"/>
                <ITEXT FONT="Alegreya Sans Bold" KERN="-1" CH="[Ar­mure]"/>
                <ITEXT KERN="-1" CH=" : "/>
                <ITEXT Unicode="25" COBJ="29789"/>
                <ITEXT KERN="-1" CH=" Arc, la touche passe, ils perdent 1 fi­gu­rine. Ils ri­postent, mais leur cible est dans un bois : ils lancent 2 dés au lieu de 4. "/>
                <ITEXT Unicode="25" COBJ="21012"/>
                <ITEXT KERN="-1" CH=" Épée et "/>
                <ITEXT Unicode="25" COBJ="24586"/>
                <ITEXT KERN="-1" CH=" Arc : une touche, les Wargs perdent 1 fi­gu­rine. Le choix tac­tique de se pla­cer dans le bois s'est avé­ré payant : les Wargs ont re­non­cé à 1 dé, les Che­va­liers à 2. Une uni­té ne pour­suit qu'une fois par tour : l'at­taq"/>
                <ITEXT CH="ue des Wargs s'ar­rête là."/>
                <para/>
                <ITEXT CH="Le bi­lan"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Points de vic­toire."/>
                <ITEXT CH=" Les Orques oc­cupent la col­line : la mé­daille ob­jec­tif va au Mal. Avec celle des Ar­chers, il a pris 2 mé­dailles ce tour."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Pioche. "/>
                <ITEXT CH="Le Mal dé­fausse Pa­trouille Gauche et pioche 1 carte : sa main re­vient à 5."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Pou­voir."/>
                <ITEXT CH=" Vi­dée à l'étape de com­man­de­ment, la ré­serve du Mal a dé­jà re­çu 3 je­tons pen­dant les at­taques : 1 pour les Pis­teurs, 1 pour les Orques, 1 pour les Wargs. Le Mal en ajoute 2 : sa ré­serve compte dé­sor­mais 5 je­tons."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="C'est au tour du Bien. Ses Che­va­liers vou­dront ven­ger les Ar­chers, mais tant que les Wargs res­tent dans le bois, ils ne lan­ce­ront que 2 dés contre eux."/>
                <para PARENT="Default Paragraph Style"/>
                <para/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="737.796275590551" YPOS="6264.09548818898" OwnPage="14" ItemID="383655569" PTYPE="4" WIDTH="481.889763779528" HEIGHT="680.314960629921" FRTYPE="3" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="14.1732283464567" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L481.89 0 L481.89 680.315 L233.028 680.315 L233.028 448.88 L0 448.88 L0 0 Z" copath="M0 0 L481.89 0 L481.89 680.315 L0 680.315 L0 0 Z" gXpos="737.796275590551" gYpos="6264.09548818898" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="383672561" BACKITEM="383666897"/>
        <PAGEOBJECT XPOS="737.796275590551" YPOS="6368.97737795277" OwnPage="14" ItemID="383681057" PTYPE="4" WIDTH="233.858267716535" HEIGHT="223.937007874016" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="RVB #c69251" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="5.66929133858268" BEXTRA="5.66929133858268" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L233.858 0 L233.858 223.937 L0 223.937 L0 0 Z" copath="M0 0 L233.858 0 L233.858 223.937 L0 223.937 L0 0 Z" gXpos="737.796275590551" gYpos="6368.97737795277" gWidth="0" gHeight="0" PSTYLE="Exemple" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Exemple"/>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="Exemple"/>
                <para PARENT="Exemple"/>
                <ITEXT CH="Les Che­va­liers de Dol Am­roth me­nés par Im­ra­hil, Gé­né­ral au Des­tin 3, sont mis en dé­route. Le Mal marque 1 point de vic­toire. À 3 hexa­gones ou moins se trouvent des Guer­riers de Los­sar­nach, me­nés par For­long le Gros, et des Hommes d'armes de Dol Am­roth. Les Guer­riers de Los­sar­nach ont dé­jà un Lea­der : seuls les Hommes d'armes peuvent ac­cueillir Im­ra­hil. Le Bien lance 3 dés : Épée, Dra­peau, Cou­ronne. Im­ra­hil est sau­vé. Sa fi­gu­rine rem­place l'une de celles des Hommes d'armes, qui ne gagnent au­cun PV, et le je­ton {LEA­DER} passe à cô­té d'eux. Son Des­tin tombe à 2. Im­ra­hil est tou­jours en jeu : la main du Bien garde toutes ses cartes."/>
                <trail PARENT="Exemple"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="737.796275590551" YPOS="6598.58367716537" OwnPage="14" ItemID="383669729" PTYPE="4" WIDTH="233.858267716535" HEIGHT="73.7007874015748" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="RVB #374317" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="5.66929133858268" BEXTRA="5.66929133858268" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L233.858 0 L233.858 73.7008 L0 73.7008 L0 0 Z" copath="M0 0 L233.858 0 L233.858 73.7008 L0 73.7008 L0 0 Z" gXpos="737.796275590551" gYpos="6598.58367716537" gWidth="0" gHeight="0" PSTYLE="A retenir" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="A retenir"/>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="À re­te­nir"/>
                <para PARENT="A retenir"/>
                <ITEXT CH="Un Lea­der rend son uni­té plus re­dou­table, et son Des­tin peut lui per­mettre de sur­vivre à sa dé­route"/>
                <trail PARENT="A retenir"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="737.741157480315" YPOS="6677.81989763783" OwnPage="14" ItemID="383678225" PTYPE="2" WIDTH="233.858267716535" HEIGHT="30.4497637795276" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="0.094297688595377" LOCALSCY="0.094297688595377" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="../06 - Images/charte/separateur_08_300dpi.png" PRFILE="sRGB display profile (ICC v2.2)" IRENDER="0" EMBEDDED="0" path="M0 0 L233.858 0 L233.858 30.4498 L0 30.4498 L0 0 Z" copath="M0 0 L233.858 0 L233.858 30.4498 L0 30.4498 L0 0 Z" ImageRes="0" gXpos="1928.29233858267" gYpos="1386.48131496061" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="170.867141732283" YPOS="7145.98525196851" OwnPage="15" ItemID="383672561" PTYPE="4" WIDTH="481.889763779528" HEIGHT="680.314960629921" FRTYPE="3" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="14.1732283464567" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L481.89 0 L481.89 275.868 L246.201 275.868 L246.201 680.315 L220.445 680.315 L0 680.315 L0 0 Z" copath="M0 0 L481.89 0 L481.89 680.315 L0 680.315 L0 0 Z" gXpos="170.867141732283" gYpos="7145.98525196851" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="397631601" BACKITEM="383655569"/>
        <PAGEOBJECT XPOS="418.166354330709" YPOS="7298.99312598426" OwnPage="15" ItemID="383686721" PTYPE="4" WIDTH="233.858267716535" HEIGHT="164.409448818898" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="RVB #c69251" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="5.66929133858268" BEXTRA="5.66929133858268" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L233.858 0 L233.858 164.409 L0 164.409 L0 0 Z" copath="M0 0 L233.858 0 L233.858 164.409 L0 164.409 L0 0 Z" gXpos="418.166354330709" gYpos="7298.99312598426" gWidth="0" gHeight="0" PSTYLE="Exemple" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Exemple"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Exemple"/>
                <para PARENT="Exemple"/>
                <ITEXT CH="Le Mal joue « At­taque Gauche » de sa main et « Pa­trouille Droite » du râ­te­lier. Le joueur Gauche ac­tive 3 uni­tés de Khand et des Orien­taux, le joueur Droite 2 uni­tés du Ha­rad. Les cartes ne donnent rien au joueur Centre : avec l'ac­cord de ses co­équi­piers, il dé­pense 6 des 7 je­tons de la ré­serve pour ac­ti­ver deux Bandes d'orques du Mor­dor "/>
                <ITEXT Unicode="25" COBJ="666"/>
                <ITEXT CH=". À l'étape de pioche, le Mal pioche 1 carte pour sa main et en re­tourne 1 dans le râ­te­lier."/>
                <trail PARENT="Exemple"/>
            </StoryText>
        </PAGEOBJECT>
