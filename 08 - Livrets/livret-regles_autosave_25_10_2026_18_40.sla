        <MASTEROBJECT XPOS="216.321722104859" YPOS="28.0629921259847" OwnPage="1" ItemID="39390225" PTYPE="4" WIDTH="362.634146341463" HEIGHT="22.386787017476" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L362.634 0 L362.634 22.3868 L0 22.3868 L0 0 Z" copath="M0 0 L362.634 0 L362.634 22.3868 L0 22.3868 L0 0 Z" OnMasterPage="Normal droite" gXpos="241416613.170356" gYpos="1411881728.84948" gWidth="0" gHeight="0" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
