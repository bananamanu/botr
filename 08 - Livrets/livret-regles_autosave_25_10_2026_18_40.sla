        </PAGEOBJECT>
        <PAGEOBJECT XPOS="746.182678509698" YPOS="249.165354330709" OwnPage="0" ItemID="39407217" PTYPE="4" WIDTH="493.463414634146" HEIGHT="199.317073170732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L493.463 0 L493.463 199.317 L0 199.317 L0 0 Z" copath="M0 0 L493.463 0 L493.463 199.317 L0 199.317 L0 0 Z" gXpos="746.182678509698" gYpos="249.165354330709" gWidth="0" gHeight="0" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
