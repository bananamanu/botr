        <PAGEOBJECT XPOS="170.867141732283" YPOS="972.756905511812" OwnPage="1" ItemID="1920389968" PTYPE="4" WIDTH="481.889763779528" HEIGHT="680.314960629921" FRTYPE="3" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="14.1732283464567" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L481.89 0 L481.89 680.315 L233.616 680.315 L233.616 368.504 L0 368.504 L0 0 Z" copath="M0 0 L481.89 0 L481.89 680.315 L0 680.315 L0 0 Z" gXpos="170.867141732283" gYpos="972.756905511812" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1920378640" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Com­ment uti­li­ser ce li­vret"/>
                <para PARENT="Titre 1"/>
                <ITEXT CH="Ce li­vret se garde sur la table. Il contient toutes les règles du jeu, clas­sées par ordre al­pha­bé­tique : quand une ques­tion se pose en cours de par­tie, c'est ici qu'on cherche la ré­ponse."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Les en­trées al­pha­bé­tiques"/>
                <ITEXT CH=" couvrent tous les termes du jeu, les règles entre cro­chets comme [Ar­mure] ou [Fé­ro­ci­té], les ter­rains et les cas par­ti­cu­liers."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Le cha­pitre des cartes de com­man­de­ment"/>
                <ITEXT CH=" donne le texte com­plet de chaque carte."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Le ta­bleau du ter­rain"/>
                <ITEXT CH=", en fin de li­vret, ré­sume les ef­fets de chaque ter­rain."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Le li­vret de règles ap­prend à jouer ; ce li­vret-ci ré­pond aux ques­tions. S'ils semblent se contre­dire, ce li­vret fait foi. Les règles propres à une ba­taille sont dans le li­vret de scé­na­rio, et celles d'une pièce unique dans le li­vret Fac­tions : elles l'em­portent sur celles de ce li­vret."/>
                <para/>
                <ITEXT CH="Les mots en "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="ita­lique"/>
                <ITEXT CH=" ren­voient à une autre en­trée de ce li­vret."/>
                <para/>
                <ITEXT CH="En­trées "/>
                <breakline/>
                <ITEXT CH="al­pha­bé­tiques"/>
                <para PARENT="Titre 1"/>
                <ITEXT CH="Ac­ti­va­tion"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Ac­ti­ver une uni­té, c'est la mettre en ac­tion pour le tour : elle peut alors se dé­pla­cer puis at­ta­quer. Une uni­té non ac­ti­vée ne bouge pas et ne com­bat pas, sauf pour re­cu­ler ou ri­pos­ter."/>
                <para/>
                <ITEXT CH="On ac­tive des uni­tés en jouant une carte de com­man­de­ment, puis, si on le sou­haite, en dé­pen­sant des je­tons de Pou­voir."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une uni­té n'est ja­mais ac­ti­vée deux fois dans le même tour, même si deux cartes, ou une carte et du Pou­voir, peuvent la dé­si­gner."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Les uni­tés ac­ti­vées sont dé­si­gnées à l'étape d'ordre, avant tout mou­ve­ment."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Voir aus­si : "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Carte de sec­tion, Carte Tac­tique, Igno­rer une carte, Pou­voir, Tour"/>
                <ITEXT CH="."/>
                <para/>
                <ITEXT CH="Ar­cher en mê­lée"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Ar­cher en mê­lée] :"/>
                <ITEXT CH=" les faces "/>
                <ITEXT Unicode="25" COBJ="29107"/>
                <ITEXT CH=" Arc de l'uni­té touchent aus­si quand elle at­taque ou ri­poste en mê­lée."/>
                <para/>
                <ITEXT CH="Les "/>
                <ITEXT Unicode="25" COBJ="19319"/>
                <ITEXT CH=" Épées croi­sées et les "/>
                <ITEXT Unicode="25" COBJ="5462"/>
                <ITEXT CH=" Épées touchent nor­ma­le­ment, comme pour toute uni­té de mê­lée."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Quand l'uni­té est Faible, ses Épées ne touchent plus, mais ses Arcs touchent tou­jours."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Ar­mure"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Ar­mure] :"/>
                <ITEXT CH=" pour chaque touche su­bie, l'uni­té lance 1 dé. Chaque "/>
                <ITEXT Unicode="25" COBJ="16844"/>
                <ITEXT CH="/"/>
                <ITEXT Unicode="25" COBJ="18300"/>
                <ITEXT CH=" Pou­voir an­nule une touche. Si un Lea­der mène l'uni­té, chaque "/>
                <ITEXT Unicode="25" COBJ="28181"/>
                <ITEXT CH=" Cou­ronne en an­nule une aus­si."/>
                <para/>
                <ITEXT CH="L'"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Ar­mure]"/>
                <ITEXT CH=" vaut contre toute at­taque, mê­lée comme tir, et contre toutes les faces qui touchent."/>
                <para/>
                <ITEXT CH="Elle se lance après la "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Pro­tec­tion"/>
                <ITEXT CH=", sur les touches qui res­tent."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Elle ne sauve pas les pertes d'une re­traite blo­quée (voir "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Re­traite"/>
                <ITEXT CH=")."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Les dés d'"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Ar­mure]"/>
                <ITEXT CH=" ne rap­portent pas de je­ton de Pou­voir."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Toute uni­té rouge et toute Créa­ture porte "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Ar­mure]"/>
                <ITEXT CH=" d'of­fice. D'autres uni­tés la re­çoivent par une règle, comme Dis­ci­pline de co­horte."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Ar­mure] "/>
                <ITEXT CH="n'est pas cu­mu­lable. Deux sources ne donnent pas deux dés par touche."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="At­taque"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="À l'étape d'at­taque, chaque uni­té ac­ti­vée peut at­ta­quer une uni­té en­ne­mie, dans l'ordre choi­si par son camp. Une uni­té peut re­non­cer à at­ta­quer. Une uni­té n'at­taque qu'une fois par tour, sauf si une règle ou une carte lui donne une at­taque de plus."/>
                <para/>
                <ITEXT CH="Une at­taque se ré­sout tou­jours dans cet ordre :"/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Choi­sir la cible"/>
                <ITEXT CH=". En mê­lée "/>
                <ITEXT Unicode="25" COBJ="130"/>
                <ITEXT CH=", une uni­té en­ne­mie ad­ja­cente. En tir "/>
                <ITEXT Unicode="25" COBJ="31903"/>
                <ITEXT CH=", une uni­té en­ne­mie à Por­tée et en Ligne de vue, ad­ja­cente com­prise."/>
                <para PARENT="Liste numérotée sans suivi"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Lan­cer les dés"/>
                <ITEXT CH=" (voir"/>
                <ITEXT FONT="Alegreya Sans Italic" CH=" Pla­fond de dés"/>
                <ITEXT CH="), puis ap­pli­quer les re­lances (voir Re­lance). Chaque {DÉ:Pou­voir} Pou­voir ob­te­nu rap­porte 1 je­ton de Pou­voir."/>
                <para PARENT="Liste numérotée sans suivi"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Comp­ter"/>
                <ITEXT CH=" les touches et les Dra­peaux (voir Faces de dé)."/>
                <para PARENT="Liste numérotée sans suivi"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="En­cais­ser"/>
                <ITEXT CH=" : Pro­tec­tion, puis Ar­mure, puis pertes. La cible qui perd sa der­nière fi­gu­rine, ou son der­nier PV, est en Dé­route."/>
                <para PARENT="Liste numérotée sans suivi"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Re­cu­ler"/>
                <ITEXT CH=" : la cible sur­vi­vante re­cule de 1 hexa­gone par Dra­peau (voir Re­traite)."/>
                <para PARENT="Liste numérotée sans suivi"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Ri­pos­ter"/>
                <ITEXT CH=" : la cible ad­ja­cente qui n'a pas bou­gé peut ri­pos­ter (voir Ri­poste)."/>
                <para PARENT="Liste numérotée sans suivi"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Avan­cer ou pour­suivre"/>
                <ITEXT CH=" : après une at­taque de mê­lée qui a fait re­cu­ler ou mis en dé­route sa cible (voir"/>
                <ITEXT FONT="Alegreya Sans Italic" CH=" Avance, Pour­suite"/>
                <ITEXT CH=")."/>
                <para PARENT="Liste numérotée sans suivi"/>
                <ITEXT CH="La mê­lée n'a pas be­soin de ligne de vue."/>
                <para/>
                <ITEXT CH="Voir aus­si : "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Faces de dé, Ter­rain"/>
                <ITEXT CH="."/>
                <para/>
                <ITEXT CH="Avance"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Quand une at­taque de mê­lée met sa cible en dé­route ou la fait re­cu­ler, l'at­ta­quant peut en­trer dans l'hexa­gone qu'elle a li­bé­ré. Rien ne l'y oblige."/>
                <para/>
                <ITEXT CH="Un tir, même sur une uni­té ad­ja­cente, ne per­met pas d'avan­cer, pas plus qu'une ri­poste."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="L'avance n'est ar­rê­tée par au­cun ter­rain : on entre dans l'hexa­gone li­bé­ré, quel qu'il soit."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une uni­té qui porte [Pour­suite] peut pour­suivre au lieu d'avan­cer (voir Pour­suite)."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une uni­té ne peut pas at­ta­quer après avoir avan­cé, sauf par une pour­suite."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Badge"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Un badge donne une règle de plus à une uni­té. Il est ma­té­ria­li­sé par un je­ton de badge d'uni­té, po­sé à cô­té d'elle. Il en existe deux :"/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Lea­der :"/>
                <ITEXT CH=" un Lea­der mène l'uni­té (voir "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Lea­der"/>
                <ITEXT CH=")."/>
                <breakline/>
                <para PARENT="Liste à puce" ALIGN="0"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Fac­tion :"/>
                <ITEXT CH=" l'uni­té a une règle propre, in­di­quée sur son pro­fil (voir "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Fac­tion"/>
                <ITEXT CH=")."/>
                <para PARENT="Liste à puce" ALIGN="0"/>
                <ITEXT CH="La fi­gu­rine avec ban­nière n'est pas un badge (voir B"/>
                <ITEXT FONT="Alegreya Sans Italic" CH="an­nière"/>
                <ITEXT CH=")."/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Ban­nière"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Une uni­té peut comp­ter une fi­gu­rine avec ban­nière. Ce n'est pas un badge, mais l'uni­té y gagne "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[In­ébran­lable 1] "/>
                <ITEXT CH=": elle peut igno­rer 1 Dra­peau à chaque at­taque qu'elle su­bit."/>
                <para/>
                <ITEXT CH="La ban­nière s'ad­di­tionne aux autres sources d'"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[In­ébran­lable]"/>
                <ITEXT CH=" (voir "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="In­ébran­lable"/>
                <ITEXT CH=")."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="La fi­gu­rine avec ban­nière est re­ti­rée en der­nier quand l'uni­té su­bit des pertes. Si un Lea­der mène l'uni­té, elle est re­ti­rée en avant-der­nier, juste avant lui."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une uni­té qui n'a plus de fi­gu­rine avec ban­nière perd cet"/>
                <ITEXT FONT="Alegreya Sans Bold" CH=" [In­ébran­lable 1]"/>
                <ITEXT CH="."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Bâ­ti­ment"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Ter­rain. Une uni­té qui entre dans un bâ­ti­ment s'y ar­rête. Elle peut com­battre de­puis le bâ­ti­ment ce tour, et en sor­tir nor­ma­le­ment au tour sui­vant."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Com­bat :"/>
                <ITEXT CH=" l'uni­té dans un bâ­ti­ment porte [Pro­tec­tion] : elle ignore 1 touche à chaque at­taque qu'elle su­bit (voir Pro­tec­tion)."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Vue :"/>
                <ITEXT CH=" un bâ­ti­ment bloque la ligne de vue. L'uni­té qui s'y trouve voit et tire nor­ma­le­ment vers l'ex­té­rieur, et on peut ti­rer sur elle."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Re­traite :"/>
                <ITEXT CH=" une uni­té qui re­cule tra­verse un bâ­ti­ment sans s'ar­rê­ter."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Bois"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Ter­rain. Une uni­té qui entre dans un bois s'y ar­rête, même s'il lui reste du mou­ve­ment. Elle en sort nor­ma­le­ment au tour sui­vant."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Com­bat :"/>
                <ITEXT CH=" quand l'at­ta­quant ou sa cible se trouve dans un bois, l'at­ta­quant lance 2 dés au plus, en mê­lée comme au tir, ri­poste com­prise. Cette li­mite s'ap­plique aux dés de l'uni­té, avant les dés en plus d'une carte ou d'une règle (voir Pla­fond de dés). Une uni­té qui lance dé­jà 2 dés n'est pas af­fec­tée."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Vue :"/>
                <ITEXT CH=" un bois bloque la ligne de vue. Une uni­té dans un bois voit et tire nor­ma­le­ment vers l'ex­té­rieur, et on peut ti­rer sur une uni­té qui s'y trouve."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Re­traite :"/>
                <ITEXT CH=" une uni­té qui re­cule tra­verse un bois sans s'ar­rê­ter."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Bord"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Chaque camp a son bord : le bord du champ de ba­taille de son cô­té. Le scé­na­rio y dé­ploie son ar­mée, ses Sec­tions se nomment de­puis lui, et ses uni­tés re­culent tou­jours vers lui."/>
                <para/>
                <ITEXT CH="Camp"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Le Bien ou le Mal. Chaque camp est me­né par un à trois joueurs et réunit un ou plu­sieurs Peuples."/>
                <para/>
                <ITEXT CH="Carte de sec­tion"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Carte de com­man­de­ment qui ac­tive des uni­tés dans une ou plu­sieurs Sec­tions. Le nombre d'uni­tés est in­di­qué sur la carte : vous choi­sis­sez les­quelles, par­mi celles qui se trouvent dans la Sec­tion vi­sée au mo­ment où vous jouez la carte."/>
                <para/>
                <ITEXT CH="Une uni­té sur un "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Hexa­gone de fron­tière"/>
                <ITEXT CH=" peut être ac­ti­vée par une carte de l'une ou l'autre de ses Sec­tions."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="S'il y a moins d'uni­tés dans la Sec­tion que la carte n'en per­met, les ac­ti­va­tions en trop sont per­dues."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Texte de chaque carte : cha­pitre "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Cartes de com­man­de­ment"/>
                <ITEXT CH="."/>
                <para/>
                <para/>
                <ITEXT CH="Carte Tac­tique"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Carte de com­man­de­ment qui ac­tive se­lon un autre cri­tère que la Sec­tion : le type, la classe, le mode… le plus sou­vent n'im­porte où sur le champ de ba­taille. Beau­coup donnent en plus un avan­tage. La carte dit tout ce qu'elle fait, et son texte l'em­porte sur les règles gé­né­rales."/>
                <para/>
                <ITEXT CH="Texte de chaque carte : cha­pitre "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Cartes de com­man­de­ment"/>
                <ITEXT CH="."/>
                <para/>
                <ITEXT CH="Champ de ba­taille"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Le ta­pis d'hexa­gones sur le­quel se joue la par­tie. Sa taille dé­pend du For­mat. Il se dé­coupe en trois Sec­tions et peut por­ter du Ter­rain."/>
                <para/>
                <ITEXT CH="Char"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Pièce sur socle unique, avec un comp­teur de PV. Un Char compte comme une uni­té de Ca­va­le­rie pour tout le reste : cartes, ac­ti­va­tions, mou­ve­ment, et règles qu'il porte d'of­fice."/>
                <para/>
                <ITEXT CH="Il se dé­place comme la Ca­va­le­rie de sa classe, sauf si son pro­fil in­dique un autre mou­ve­ment."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Il lit la ligne de la Ca­va­le­rie de son mode dans la grille des règles d'of­fice (voir "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Type"/>
                <ITEXT CH=")."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Il n'est ja­mais "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Faible"/>
                <ITEXT CH="."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Chaque touche lui re­tire 1 PV."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Classe"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="La classe donne le nombre de dés que l'uni­té lance quand elle at­taque. Elle se lit à la cou­leur de son je­ton classe/mode."/>
                <para/>
                <ITEXT CH="La classe fixe aus­si le Mou­ve­ment de l'uni­té et son coût en je­tons de Pou­voir : au­tant de je­tons que de dés."/>
                <para/>
                <ITEXT CH="Col­line"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Ter­rain. Une col­line ne freine pas le mou­ve­ment."/>
                <para/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Com­bat :"/>
                <ITEXT CH=" une uni­té sur une col­line lance 1 dé de plus quand elle at­taque une cible en contre­bas, en mê­lée comme au tir, ri­poste com­prise. Le bo­nus dis­pa­raît si la cible est elle aus­si sur une col­line. Une uni­té qui at­taque une cible sur une col­line de­puis le contre­bas lance ses dés nor­ma­le­ment."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Vue :"/>
                <ITEXT CH=" une col­line bloque la ligne de vue des uni­tés en contre­bas."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Vue de­puis une col­line :"/>
                <ITEXT CH=" une uni­té sur une col­line ignore, pour tra­cer sa ligne de vue, les uni­tés ad­ja­centes à elle et en contre­bas. Toute autre uni­té in­ter­po­sée bloque sa vue nor­ma­le­ment, de même que tout ter­rain qui bloque la vue."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Re­traite :"/>
                <ITEXT CH=" une uni­té qui re­cule tra­verse une col­line sans s'ar­rê­ter."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Com­man­de­ment"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Pre­mière étape du tour. Le camp joue sa ou ses cartes de com­man­de­ment, puis peut dé­pen­ser des je­tons de Pou­voir pour ac­ti­ver des uni­tés sup­plé­men­taires."/>
                <para/>
                <ITEXT CH="En for­mat Es­car­mouche ou Nor­mal, le camp joue "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="1 carte"/>
                <ITEXT CH=" de sa main."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="En for­mat Épique, le camp joue "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="jus­qu'à 2 cartes de sec­tion"/>
                <ITEXT CH=", dont une au plus de sa main et une au plus du Râ­te­lier, "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="ou une seule carte Tac­tique"/>
                <ITEXT CH=", de sa main ou du râ­te­lier. Il ne joue ja­mais une carte de sec­tion et une carte Tac­tique dans le même tour, ni deux cartes Tac­tiques."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Vous pou­vez tou­jours igno­rer le texte d'une carte (voir"/>
                <ITEXT FONT="Alegreya Sans Italic" CH=" Igno­rer une carte"/>
                <ITEXT CH=")."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Voir aus­si : "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Main, Va­leur de com­man­de­ment"/>
                <ITEXT CH="."/>
                <para/>
                <ITEXT CH="Contrôle d'une uni­té"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Quand un camp compte plu­sieurs joueurs, cha­cun com­mande les uni­tés de son camp qui se trouvent dans sa Sec­tion au"/>
                <ITEXT FONT="Alegreya Sans Bold" CH=" dé­but du tour"/>
                <ITEXT CH="."/>
                <para/>
                <ITEXT CH="Une uni­té qui fran­chit une ligne de Sec­tion pen­dant le tour reste au joueur qui l'a ac­ti­vée jus­qu'à la fin du tour, puis passe au joueur de sa nou­velle Sec­tion."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une uni­té qui change de Sec­tion en re­cu­lant passe de même au joueur de sa nou­velle Sec­tion au tour sui­vant."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Pen­dant le tour ad­verse, c'est le joueur de la Sec­tion où se trouve l'uni­té qui la fait re­cu­ler, ri­pos­ter et qui lance son Des­tin."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une uni­té sur un Hexa­gone de fron­tière peut être ac­ti­vée par l'un ou l'autre des deux joueurs voi­sins, ja­mais par les deux."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Cou­ronne"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Face de dé "/>
                <ITEXT Unicode="25" COBJ="4318"/>
                <ITEXT CH=". Elle ne fait rien, sauf pour une uni­té me­née par un Lea­der :"/>
                <para/>
                <ITEXT CH="en at­taque comme en ri­poste, chaque Cou­ronne in­flige 1 touche ;"/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="sur un jet d'[Ar­mure], chaque Cou­ronne an­nule 1 touche ;"/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="c'est aus­si la face qui sauve un Lea­der lors d'un jet de Des­tin."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="La carte Cri de guerre donne aus­si un ef­fet à la Cou­ronne (cha­pitre"/>
                <ITEXT FONT="Alegreya Sans Italic" CH=" Cartes de com­man­de­ment"/>
                <ITEXT CH=")."/>
                <para/>
                <ITEXT CH="Cours d'eau"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Ter­rain in­fran­chis­sable. Au­cune uni­té n'y entre ni ne le tra­verse, en se dé­pla­çant comme en re­cu­lant. On ne le fran­chit que par un Gué ou un Pont."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Vue :"/>
                <ITEXT CH=" un cours d'eau ne bloque pas la ligne de vue."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Re­traite :"/>
                <ITEXT CH=" un cours d'eau bloque la re­traite (voir Re­traite)."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Créa­ture"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Pièce sur socle unique, avec un comp­teur de PV."/>
                <para/>
                <ITEXT CH="Toute Créa­ture porte d'of­fice "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Ar­mure]"/>
                <ITEXT CH=" et "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Peur 1]"/>
                <ITEXT CH=", quelle que soit sa classe."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Elle se dé­place comme l'In­fan­te­rie de sa classe, sauf si son pro­fil in­dique un autre mou­ve­ment."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Elle n'est ja­mais "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Faible"/>
                <ITEXT CH="."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Chaque touche lui re­tire 1 PV."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Dé­route"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Une uni­té qui perd sa der­nière fi­gu­rine, ou son der­nier PV, est en dé­route : re­ti­rez-la du champ de ba­taille. L'ad­ver­saire marque aus­si­tôt 1 point de vic­toire et prend une mé­daille."/>
                <para/>
                <ITEXT CH="La dé­route peut ve­nir d'une at­taque, d'une ri­poste ou d'une re­traite blo­quée."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Si un Lea­der me­nait l'uni­té, il tente aus­si­tôt de sur­vivre (voir "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Des­tin"/>
                <ITEXT CH="). Le point de vic­toire est mar­qué dans tous les cas."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Des­tin"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Va­leur d'un Lea­der, de 1 à 4, in­di­quée sur son pro­fil. Quand une uni­té me­née par un Lea­der est mise en dé­route, l'ad­ver­saire marque son point de vic­toire comme d'ha­bi­tude, puis le Lea­der tente de re­joindre une autre uni­té :"/>
                <para/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Choi­sis­sez une uni­té de re­pli :"/>
                <ITEXT CH=" une uni­té amie de son peuple, sans Lea­der, à 3 hexa­gones ou moins de l'hexa­gone qu'oc­cu­pait son uni­té. S'il n'y en a au­cune, le Lea­der est éli­mi­né, sans jet."/>
                <para PARENT="Liste numérotée sans suivi"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Lan­cez au­tant de dés que sa va­leur de Des­tin."/>
                <ITEXT CH=" Ces dés ne rap­portent pas de Pou­voir."/>
                <para PARENT="Liste numérotée sans suivi"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Au moins une "/>
                <ITEXT FONT="Alegreya Sans Bold" Unicode="25" COBJ="12062"/>
                <ITEXT FONT="Alegreya Sans Bold" CH=" Cou­ronne : il est sau­vé. "/>
                <ITEXT CH="Il re­joint l'uni­té de re­pli de votre choix, et sa va­leur de Des­tin baisse de 1 pour le reste de la par­tie. Sans Cou­ronne, il est éli­mi­né."/>
                <para PARENT="Liste numérotée sans suivi"/>
                <ITEXT CH="Le Lea­der sau­vé prend la place d'une fi­gu­rine or­di­naire de l'uni­té qui l'ac­cueille : re­ti­rez-en une et po­sez la sienne. L'uni­té ne gagne au­cun PV. Po­sez le je­ton "/>
                <ITEXT Unicode="25" COBJ="26882"/>
                <ITEXT CH=" à cô­té d'elle. Sur un Char ou une Créa­ture, seul le je­ton change de place."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Un Lea­der dont le Des­tin tombe à 0 n'a plus de jet : il est éli­mi­né avec sa pro­chaine uni­té."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Un Lea­der uni­ver­sel, comme son pro­fil le pré­cise, peut re­joindre une uni­té de n'im­porte quel peuple de son camp."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Un Lea­der éli­mi­né ne rap­porte pas de point de vic­toire, sauf si le scé­na­rio en fait un ob­jec­tif."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Un Gé­né­ral sau­vé reste en jeu : la main de son camp ne change pas."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Dis­ci­pline de co­horte"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Dis­ci­pline de co­horte] "/>
                <ITEXT CH="(badge Fac­tion) : aus­si­tôt après son at­taque, l'uni­té peut se mettre en po­si­tion dé­fen­sive. Po­sez le je­ton de po­si­tion dé­fen­sive à cô­té d'elle. Une uni­té ac­ti­vée qui re­nonce à at­ta­quer peut prendre la po­si­tion à l'étape d'at­taque."/>
                <para/>
                <ITEXT CH="Tant que le je­ton est en place :"/>
                <para/>
                <ITEXT CH="l'uni­té porte [Ar­mure] et [In­ébran­lable 1] ;"/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="elle ne ri­poste pas."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Re­ti­rez le je­ton au dé­but de sa pro­chaine ac­ti­va­tion, avant qu'elle ne bouge. Il reste en place si l'uni­té re­cule."/>
                <para/>
                <ITEXT CH="Ce "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[In­ébran­lable 1]"/>
                <ITEXT CH=" s'ad­di­tionne aux autres sources (voir "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="In­ébran­lable"/>
                <ITEXT CH=")."/>
                <para/>
                <ITEXT CH="Une uni­té qui porte dé­jà "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Ar­mure]"/>
                <ITEXT CH=" n'y gagne que "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[In­ébran­lable 1]"/>
                <ITEXT CH=" : deux sources ne donnent pas deux dés par touche."/>
                <para/>
                <ITEXT CH="Dra­peau"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Face de dé "/>
                <ITEXT Unicode="25" COBJ="2508"/>
                <ITEXT CH=". Chaque Dra­peau fait re­cu­ler la cible de 1 hexa­gone, en mê­lée comme au tir (voir "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Re­traite"/>
                <ITEXT CH="). D'autres règles pro­duisent aus­si des Dra­peaux, comme "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Peur]"/>
                <ITEXT CH="."/>
                <para/>
                <ITEXT CH="Épique"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="For­mat des grandes ba­tailles : champ de ba­taille de 17 × 13 hexa­gones. Il se joue à deux joueurs, ou à six en Mode mul­ti-joueurs. Quel que soit le nombre de joueurs, les règles sui­vantes s'y ap­pliquent :"/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Le râ­te­lier :"/>
                <ITEXT CH=" 3 cartes face vi­sible, com­munes aux deux camps (voir Râ­te­lier)."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Jouer ses cartes :"/>
                <ITEXT CH=" jus­qu'à 2 cartes de sec­tion, ou une seule carte Tac­tique (voir Com­man­de­ment)."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="La va­leur de com­man­de­ment"/>
                <ITEXT CH=" ne compte que la main, ja­mais le râ­te­lier (voir Va­leur de com­man­de­ment)."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Ordre di­rect et Contre-at­taque"/>
                <ITEXT CH=" ont une ver­sion Épique (cha­pitre "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Cartes de com­man­de­ment"/>
                <ITEXT CH=")."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Les Gé­né­raux "/>
                <ITEXT CH="ne sont pas li­mi­tés en nombre."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Faces de dé"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Chaque dé a six faces. Le "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Mode"/>
                <ITEXT CH=" de l'uni­té, rap­pe­lé par son je­ton, dit quelles faces touchent."/>
                <para/>
                <ITEXT CH="Un ti­ret si­gni­fie que la face ne fait rien. Chaque camp lance ses propres dés : la face Pou­voir porte la Rune de Gan­dalf sur ceux du Bien, l'Œil de Sau­ron sur ceux du Mal. C'est la même face, avec le même ef­fet."/>
                <para/>
                <ITEXT CH="Voir aus­si : "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Ar­cher en mê­lée, Cou­ronne, Dra­peau, Faible, Pou­voir"/>
                <ITEXT CH="."/>
                <para/>
                <ITEXT CH="Fac­tion"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Badge qui donne à une uni­té une règle propre. Le pro­fil de l'uni­té, dans le li­vret Fac­tions, dit la­quelle. Les règles de badge Fac­tion sont dé­fi­nies dans ce li­vret : "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Dis­ci­pline de co­horte, Fé­ro­ci­té, Horde, Mer­ce­naire, Poi­son, Re­lance"/>
                <ITEXT CH="."/>
                <para/>
                <ITEXT CH="Le badge Fac­tion n'est ja­mais au­to­ma­tique : le scé­na­rio ou la com­po­si­tion d'ar­mée dit quelles uni­tés le portent."/>
                <para/>
                <ITEXT CH="Faible"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Une uni­té d'In­fan­te­rie ou de Ca­va­le­rie ré­duite à une seule fi­gu­rine est Faible : ses "/>
                <ITEXT Unicode="25" COBJ="22037"/>
                <ITEXT CH=" Épées ne touchent plus en mê­lée. Seules ses Épées croi­sées touchent en­core, ain­si que ses Cou­ronnes si un Lea­der la mène."/>
                <para/>
                <ITEXT CH="Un Char ou une Créa­ture n'est ja­mais Faible."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une uni­té de tir n'est pas gê­née : elle touche sur Arc."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une uni­té me­née par un Lea­der ré­duite à la fi­gu­rine du Lea­der est Faible elle aus­si."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Fé­ro­ci­té"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Fé­ro­ci­té]"/>
                <ITEXT CH=" (badge Fac­tion) : l'uni­té peut ri­pos­ter même si l'at­taque qu'elle su­bit la fait re­cu­ler. Elle ré­sout d'abord sa ri­poste, puis re­cule."/>
                <para/>
                <ITEXT CH="Elle doit rem­plir les autres condi­tions de la ri­poste : être ad­ja­cente à l'at­ta­quant et ne pas être en dé­route."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Elle ne ri­poste pas contre un at­ta­quant qui porte "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Vi­gi­lant]"/>
                <ITEXT CH="."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Gé­né­ral"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Sta­tut d'un Lea­der, in­di­qué sur son pro­fil. Tant qu'un Gé­né­ral est en jeu, la main de son camp compte 1 carte de plus."/>
                <para/>
                <ITEXT CH="Quand un Gé­né­ral est éli­mi­né, son camp dé­fausse aus­si­tôt une carte de sa main, à son choix, même pen­dant le tour ad­verse. La main compte dé­sor­mais une carte de moins."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Un Gé­né­ral sau­vé par son Des­tin reste en jeu : la main ne change pas."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Nombre de Gé­né­raux par camp : 2 au plus en Es­car­mouche, 3 au plus en Nor­mal, sans li­mite en Épique."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Gué"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Ter­rain qui per­met de fran­chir un Cours d'eau. Une uni­té qui entre dans un gué s'y ar­rête. Elle en sort nor­ma­le­ment au tour sui­vant."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Com­bat :"/>
                <ITEXT CH=" une uni­té dans un gué lance 2 dés au plus quand elle at­taque ou ri­poste. Celle qui l'at­taque de­puis la berge lance ses dés nor­ma­le­ment. Cette li­mite s'ap­plique aux dés de l'uni­té, avant les dés en plus d'une carte ou d'une règle (voir Pla­fond de dés)."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Vue :"/>
                <ITEXT CH=" un gué ne bloque pas la ligne de vue."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Re­traite :"/>
                <ITEXT CH=" une uni­té qui re­cule tra­verse un gué sans s'ar­rê­ter."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Hexa­gone"/>
                <para PARENT="Titre 2"/>
                <ITEXT KERN="-1.7" CH="Le champ de ba­taille est dé­cou­pé en hexa­gones. Une uni­té oc­cupe tou­jours un hexa­gone en­tier, et un hexa­gone n'ac­cueille ja­mais qu'une seule uni­té. Les rares pièces qui en couvrent plu­sieurs le pré­cisent sur leur"/>
                <ITEXT CH=" pro­fil."/>
                <para/>
                <ITEXT CH="Deux hexa­gones qui par­tagent un cô­té sont ad­ja­cents. Toutes les dis­tances se comptent en hexa­gones."/>
                <para/>
                <ITEXT CH="Hexa­gone de fron­tière"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Une ligne de Sec­tion peut cou­per des hexa­gones en deux au lieu de suivre leurs cô­tés. Un hexa­gone ain­si cou­pé ap­par­tient aux deux Sec­tions voi­sines : une carte de l'une comme de l'autre peut ac­ti­ver l'uni­té qui s'y trouve."/>
                <para/>
                <ITEXT CH="Quand un camp compte plu­sieurs joueurs, cha­cun des deux joueurs voi­sins peut l'ac­ti­ver, ou l'ache­ter avec du Pou­voir."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Comme toute uni­té, elle n'est ac­ti­vée qu'une seule fois par tour."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Horde"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Horde]"/>
                <ITEXT CH=" (badge Fac­tion) : tant que l'uni­té est à pleine san­té, sans avoir per­du une seule fi­gu­rine ni un seul PV, elle lance 1 dé de plus en com­bat et porte"/>
                <ITEXT FONT="Alegreya Sans Bold" CH=" [In­ébran­lable 1]"/>
                <ITEXT CH=". Dès sa pre­mière perte, ces deux ef­fets dis­pa­raissent pour le reste de la par­tie, sans autre consé­quence."/>
                <para/>
                <ITEXT CH="Le dé en plus vaut en at­taque comme en ri­poste, et compte dans le "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Pla­fond de dés"/>
                <ITEXT CH="."/>
                <para PARENT="Liste à puce" ALIGN="0"/>
                <ITEXT CH="Ce "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[In­ébran­lable 1]"/>
                <ITEXT CH=" s'ad­di­tionne aux autres sources (voir "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="In­ébran­lable"/>
                <ITEXT CH=")."/>
                <para PARENT="Liste à puce" ALIGN="0"/>
                <ITEXT CH="Une touche an­nu­lée par l'"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Ar­mure]"/>
                <ITEXT CH=" n'est pas une perte."/>
                <para PARENT="Liste à puce" ALIGN="0"/>
                <ITEXT CH="Igno­rer une carte"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Vous pou­vez tou­jours igno­rer le texte de la carte que vous jouez, et ac­ti­ver à la place 1 uni­té de votre choix, n'im­porte où sur le champ de ba­taille. La carte est dé­faus­sée et rem­pla­cée comme d'ha­bi­tude."/>
                <para/>
                <ITEXT CH="Son texte étant igno­ré, la carte ne pro­duit au­cun autre ef­fet : un Éclai­reur ain­si joué ne fait pas pio­cher 2 cartes."/>
                <para/>
                <ITEXT CH="In­ébran­lable"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[In­ébran­lable X] : "/>
                <ITEXT CH="l'uni­té peut igno­rer jus­qu'à X Dra­peaux à chaque at­taque qu'elle su­bit, quelle qu'en soit la source : dés, [Peur], ef­fets."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="C'est un choix."/>
                <ITEXT CH=" Son camp dé­cide, Dra­peau par Dra­peau, d'en igno­rer ou non. Il peut pré­fé­rer lais­ser l'uni­té re­cu­ler, par exemple pour la dé­ga­ger."/>
                <para PARENT="Liste à puce" ALIGN="3"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Les sources s'ad­di­tionnent. "/>
                <ITEXT CH="Une fi­gu­rine avec ban­nière donne "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[In­ébran­lable 1]"/>
                <ITEXT CH=" à son uni­té, un Lea­der à son uni­té et à chaque uni­té amie ad­ja­cente ; "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Horde]"/>
                <ITEXT CH=" et "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Dis­ci­pline de co­horte]"/>
                <ITEXT CH=" en donnent aus­si. Une uni­té avec ban­nière, ad­ja­cente à un Lea­der ami, porte [In­ébran­lable 2]."/>
                <para PARENT="Liste à puce" ALIGN="3"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[In­ébran­lable ∞] :"/>
                <ITEXT CH=" l'uni­té ne re­cule ja­mais. Elle ignore tous les Dra­peaux."/>
                <para PARENT="Liste à puce" ALIGN="3"/>
                <ITEXT CH="Un Dra­peau igno­ré ne fait rien : il ne cause pas de perte."/>
                <para PARENT="Liste à puce" ALIGN="3"/>
                <ITEXT CH="Je­ton classe/mode"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Je­ton po­sé à cô­té de chaque uni­té. Sa cou­leur rap­pelle sa Classe, son sym­bole son Mode : des épées croi­sées pour la mê­lée, un arc pour le tir. Il suf­fit à sa­voir com­bien de dés lance l'uni­té et sur quelles faces elle touche."/>
                <para/>
                <ITEXT CH="Lea­der"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Badge. Un Lea­der est un per­son­nage nom­mé qui mène une uni­té. Sa fi­gu­rine fait par­tie de l'uni­té, et le je­ton de badge d'uni­té po­sé à cô­té d'elle le si­gnale."/>
                <para/>
                <ITEXT CH="Un Lea­der donne à son uni­té :"/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="une touche sur chaque "/>
                <ITEXT Unicode="25" COBJ="21015"/>
                <ITEXT CH=" Cou­ronne, en at­taque comme en ri­poste ;"/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="si l'uni­té porte "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Ar­mure]"/>
                <ITEXT CH=", l'an­nu­la­tion d'une touche sur chaque Cou­ronne, comme sur un Pou­voir ;"/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[In­ébran­lable 1]"/>
                <ITEXT CH=", pour son uni­té et pour chaque uni­té amie ad­ja­cente."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Règles du Lea­der :"/>
                <para/>
                <ITEXT KERN="0" CH="La fi­gu­rine du Lea­der est tou­jours re­ti­rée en der­nier."/>
                <para PARENT="Liste à puce"/>
                <ITEXT KERN="0" CH="Une uni­té n'est ja­mais me­née par plus d'un Lea­der."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Un Lea­der peut me­ner n'im­porte quelle uni­té de son peuple. Quelques uni­tés in­cluent leur Lea­der dans leur pro­fil."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Cer­tains Lea­ders sont aus­si des Gé­né­raux. Cha­cun a une va­leur de "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Des­tin"/>
                <ITEXT CH="."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Ligne de vue"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Pour ti­rer, une uni­té doit voir sa cible. Ten­dez une ligne droite du centre de l'hexa­gone du ti­reur au centre de l'hexa­gone de la cible. Elle est blo­quée si elle tra­verse un hexa­gone qui contient :"/>
                <para/>
                <ITEXT CH="une autre uni­té, amie ou en­ne­mie ;"/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="un ter­rain qui bloque la vue : bois, col­line ou bâ­ti­ment."/>
                <para PARENT="Liste à puce" ALIGN="3"/>
                <ITEXT CH="Pré­ci­sions :"/>
                <para/>
                <ITEXT CH="L'hexa­gone du ti­reur et ce­lui de la cible ne comptent pas : on peut ti­rer de­puis un bois, et sur une uni­té dans un bois."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Quand la ligne longe exac­te­ment le cô­té com­mun à deux hexa­gones, elle n'est blo­quée que si ces deux hexa­gones la bloquent l'un et l'autre."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une uni­té sur une col­line voit par-des­sus les uni­tés ad­ja­centes en contre­bas (voir Col­line)."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Cours d'eau, gué, pont et plaine ne bloquent pas la vue."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Cer­taines pièces ont leurs propres règles de vue, in­di­quées sur leur pro­fil."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="La mê­lée n'a pas be­soin de ligne de vue."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Main"/>
                <para PARENT="Titre 2"/>
                <ITEXT KERN="-1" CH="Les cartes de com­man­de­ment d'un camp, te­nues se­crètes : 4 cartes, plus 1 par Gé­né­ral en jeu, dans tous les for­mats. Les deux camps piochent dans le même deck"/>
                <ITEXT CH="."/>
                <para/>
                <ITEXT CH="À l'étape de pioche, le camp com­plète sa main pour chaque carte jouée de sa main."/>
                <para PARENT="Liste à puce"/>
                <ITEXT KERN="-1" CH="Quand un Gé­né­ral est éli­mi­né, le camp dé­fausse aus­si­tôt une carte : la main en compte une de moins."/>
                <para PARENT="Liste à puce"/>
                <ITEXT KERN="-2" CH="En "/>
                <ITEXT FONT="Alegreya Sans Italic" KERN="-2" CH="Mode mul­ti-joueurs"/>
                <ITEXT KERN="-2" CH=", le joueur Centre tient la main et la montre à ses co­équi­piers, ja­mais à l'ad­ver­saire."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Manche"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Un tour de chaque camp. Le scé­na­rio in­dique le camp qui ouvre chaque manche."/>
                <para/>
                <ITEXT CH="Mer­ce­naire"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Mer­ce­naire]"/>
                <ITEXT CH=" (badge Fac­tion) : chaque Dra­peau qui fait re­cu­ler l'uni­té la fait re­cu­ler de "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="2 hexa­gones"/>
                <ITEXT CH=" au lieu d'un."/>
                <para/>
                <ITEXT CH="Si sa re­traite est blo­quée, elle perd 1 fi­gu­rine par hexa­gone qu'elle n'a pas pu par­cou­rir, donc jus­qu'à 2 par Dra­peau."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Les Dra­peaux igno­rés grâce à "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[In­ébran­lable]"/>
                <ITEXT CH=" ne la font pas re­cu­ler du tout."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Mo­bi­li­té"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Mo­bi­li­té X] :"/>
                <ITEXT CH=" juste après avoir at­ta­qué, l'uni­té peut se dé­pla­cer de X hexa­gones de plus."/>
                <para/>
                <ITEXT CH="Ce dé­pla­ce­ment se fait aus­si­tôt, avant qu'une autre uni­té at­taque."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Il suit les règles nor­males du "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Mou­ve­ment"/>
                <ITEXT CH=" : il est ar­rê­té par un bois, un gué ou un bâ­ti­ment."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Il vaut aus­si après un tir sur une uni­té ad­ja­cente."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une uni­té qui re­nonce à at­ta­quer n'en pro­fite pas, pas plus qu'une uni­té qui ri­poste."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une carte qui in­ter­dit de se dé­pla­cer, comme Pluie de flèches, in­ter­dit aus­si ce dé­pla­ce­ment."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Portent "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Mo­bi­li­té]"/>
                <ITEXT CH=" d'of­fice : l'In­fan­te­rie lé­gère de tir "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Mo­bi­li­té 1]"/>
                <ITEXT CH=", la Ca­va­le­rie lé­gère de tir "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Mo­bi­li­té"/>
                <nbspace FONT="Alegreya Sans Bold"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="2]"/>
                <ITEXT CH=", la Ca­va­le­rie stan­dard de tir "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Mo­bi­li­té 1]"/>
                <ITEXT CH="."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Mode"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="La fa­çon de com­battre de l'uni­té, lue au sym­bole de son je­ton classe/mode."/>
                <para/>
                <ITEXT Unicode="25" COBJ="6650"/>
                <ITEXT FONT="Alegreya Sans Bold" CH=" Mê­lée :"/>
                <ITEXT CH=" l'uni­té at­taque une uni­té en­ne­mie ad­ja­cente et touche sur Épées croi­sées et Épée."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" Unicode="25" COBJ="16291"/>
                <ITEXT FONT="Alegreya Sans Bold" KERN="-1" CH=" Dis­tance : "/>
                <ITEXT KERN="-1" CH="l'uni­té tire sur une uni­té en­ne­mie à por­tée et en ligne de vue, et touche sur Arc. Elle peut aus­si ti­rer sur une uni­té ad­ja­cente, et ri­poste ain­si."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Mode mul­ti-joueurs"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Le for­mat "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Épique"/>
                <ITEXT CH=" peut se jouer à six, trois joueurs par camp. Chaque joueur com­mande une Sec­tion de son camp : Gauche, Centre ou Droite."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Cartes :"/>
                <ITEXT CH=" le camp ne tient qu'une main, te­nue par le joueur Centre, qui la montre à ses deux co­équi­piers. Les trois joueurs dis­cutent des cartes à jouer ; le joueur Centre a le der­nier mot. Chaque joueur ac­tive, dé­place et fait com­battre en­suite les uni­tés de sa propre Sec­tion."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" KERN="-2" CH="Cartes qui ac­tivent un nombre li­mi­té d'uni­tés n'im­porte où"/>
                <ITEXT KERN="-2" CH=" ("/>
                <ITEXT FONT="Alegreya Sans Italic" KERN="-2" CH="Charge de ca­va­le­rie, As­saut d'in­fan­te­rie, Ban­nières, Ordre di­rect, Cri de guerre, Igno­rer une carte"/>
                <ITEXT KERN="-2" CH=") : les joueurs se ré­par­tissent les ac­ti­va­tions à la dis­cus­sion. S'ils ne s'en­tendent pas, le joueur Centre tranche."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Pou­voir :"/>
                <ITEXT CH=" la ré­serve est com­mune au camp. Chaque joueur peut ache­ter jus­qu'à 2 uni­tés de sa propre Sec­tion ; si les joueurs ne s'en­tendent pas sur l'usage de la ré­serve, le joueur Centre tranche."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Contrôle :"/>
                <ITEXT CH=" voir "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Contrôle d'une uni­té et Hexa­gone de fron­tière"/>
                <ITEXT CH="."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Mou­ve­ment"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Une uni­té ne bouge que si elle est ac­ti­vée. À l'étape de mou­ve­ment, son camp dé­place ses uni­tés ac­ti­vées une à une, cha­cune ter­mi­nant son dé­pla­ce­ment avant que la sui­vante com­mence. Toutes les uni­tés se dé­placent avant la pre­mière at­taque."/>
                <para/>
                <ITEXT CH="Un Char se dé­place comme la Ca­va­le­rie de sa classe, une Créa­ture comme l'In­fan­te­rie de sa classe, sauf mou­ve­ment propre in­di­qué sur le pro­fil."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une uni­té peut tou­jours se dé­pla­cer de moins, ou res­ter sur place."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Bou­ger ou frap­per : "/>
                <ITEXT CH="une uni­té rouge qui va au bout de sa plus longue dis­tance ne peut plus at­ta­quer ce tour. Rien à an­non­cer : c'est la dis­tance par­cou­rue qui dé­cide."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Ce qui ar­rête : "/>
                <ITEXT CH="une uni­té n'entre ja­mais dans un hexa­gone oc­cu­pé et ne le tra­verse pas, que l'uni­té qui s'y trouve soit amie ou en­ne­mie. Elle ne quitte ja­mais le champ de ba­taille. Un bois, un gué ou un bâ­ti­ment l'ar­rête ; un cours d'eau lui barre le pas­sage."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Rien d'autre ne gêne : "/>
                <ITEXT CH="une uni­té peut pas­ser à cô­té d'une uni­té en­ne­mie, et s'ar­rê­ter contre elle pour l'at­ta­quer."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Les Sec­tions n'ont au­cun ef­fet sur le mou­ve­ment : une uni­té peut fran­chir une ligne de Sec­tion (voir "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Contrôle d'une uni­té"/>
                <ITEXT CH=")."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une carte peut chan­ger le mou­ve­ment des uni­tés qu'elle ac­tive : son texte l'em­porte."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une uni­té qui a at­ta­qué ne se dé­place plus, sauf par une "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Avance"/>
                <ITEXT CH=", une "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Pour­suite"/>
                <ITEXT CH=" ou "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Mo­bi­li­té]"/>
                <ITEXT CH="."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Ob­jec­tif"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Hexa­gone ou but fixé par le scé­na­rio, qui rap­porte des points de vic­toire."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Ob­jec­tif ac­quis :"/>
                <ITEXT CH=" rap­porte ses points une fois pour toutes, comme éli­mi­ner une uni­té pré­cise."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Ob­jec­tif d'oc­cu­pa­tion :"/>
                <ITEXT CH=" tem­po­raire. À chaque étape des points de vic­toire, quel que soit le camp qui joue, sa mé­daille va au camp dont une uni­té oc­cupe l'hexa­gone. S'il est vide, elle ne va à per­sonne."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Peuple"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Ro­han, Gon­dor, Mor­dor, Ha­rad, Khand, Orien­taux… Chaque peuple a son cha­pitre dans le li­vret Fac­tions. Un camp en réunit sou­vent plu­sieurs."/>
                <para/>
                <para/>
                <ITEXT CH="Peur"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Peur X] :"/>
                <ITEXT CH=" chaque "/>
                <ITEXT Unicode="25" COBJ="14139"/>
                <ITEXT CH="/"/>
                <ITEXT Unicode="25" COBJ="11989"/>
                <ITEXT CH=" Pou­voir ob­te­nu par l'uni­té quand elle at­taque ou ri­poste compte comme X Dra­peaux de plus contre la cible. La Peur fait re­cu­ler, elle ne touche pas."/>
                <para/>
                <ITEXT CH="Toute "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Créa­ture"/>
                <ITEXT CH=" porte "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Peur 1] "/>
                <ITEXT CH="d'of­fice. Si son pro­fil in­dique une va­leur plus haute, comme "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Peur 2]"/>
                <ITEXT CH=", celle-ci la rem­place."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="La cible peut igno­rer ces Dra­peaux grâce à "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[In­ébran­lable]"/>
                <ITEXT CH=", comme ceux des dés."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Chaque Pou­voir rap­porte aus­si son je­ton de Pou­voir, sauf en ri­poste."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Pla­fond de dés"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Pour sa­voir com­bien de dés lance une uni­té, comp­tez dans cet ordre :"/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Les dés de l'uni­té :"/>
                <ITEXT CH=" 2, 3 ou 4 se­lon sa classe ;"/>
                <para PARENT="Liste numérotée sans suivi"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="les li­mites du ter­rain :"/>
                <ITEXT CH=" 2 dés au plus si l'at­ta­quant ou sa cible est dans un bois, ou si l'at­ta­quant est dans un gué ;"/>
                <para PARENT="Liste numérotée sans suivi"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="les dés en plus"/>
                <ITEXT CH=" d'une carte, d'une col­line ou d'une règle comme [Horde] ;"/>
                <para PARENT="Liste numérotée sans suivi"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="ja­mais plus de 6 dés au to­tal."/>
                <para PARENT="Liste numérotée sans suivi"/>
                <ITEXT CH="Plaine"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Hexa­gone sans ter­rain. Il n'a au­cun ef­fet."/>
                <para/>
                <ITEXT CH="Poi­son"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Poi­son]"/>
                <ITEXT CH=" (badge Fac­tion) : quand l'uni­té at­taque ou ri­poste, chaque "/>
                <ITEXT Unicode="25" COBJ="30901"/>
                <ITEXT CH=" Pou­voir qu'elle ob­tient em­poi­sonne sa cible. Po­sez le je­ton Em­poi­son­née  à cô­té de la cible. Ce Pou­voir ne touche pas."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Cible em­poi­son­née."/>
                <ITEXT CH=" Toute at­taque contre une uni­té em­poi­son­née touche aus­si sur "/>
                <ITEXT Unicode="25" COBJ="24112"/>
                <ITEXT CH=" Pou­voir, que l'at­ta­quant porte "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Poi­son]"/>
                <ITEXT CH=" ou non."/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Le je­ton reste en place jus­qu'à la dé­route de l'uni­té. Une uni­té n'est em­poi­son­née qu'une fois : un se­cond je­ton ne change rien."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une ri­poste contre une uni­té em­poi­son­née touche aus­si sur Pou­voir."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Les touches sur Pou­voir s'ajoutent aux autres : [Pro­tec­tion] et [Ar­mure] s'ap­pliquent."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Sur une cible em­poi­son­née, le Pou­voir touche et dé­clenche la règle de l'at­ta­quant, comme [Peur]."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Chaque Pou­voir rap­porte aus­si son je­ton de Pou­voir, sauf en ri­poste."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Pont"/>
                <para PARENT="Titre 2"/>
                <ITEXT KERN="0" CH="Ter­rain qui per­met de fran­chir un "/>
                <ITEXT FONT="Alegreya Sans Italic" KERN="0" CH="Cours d'eau"/>
                <ITEXT KERN="0" CH=". Un pont ne freine pas le mou­ve­ment, ne change rien au com­bat et ne bloque pas la vue. Il n'ac­cueille qu'une uni­té."/>
                <para/>
                <ITEXT CH="Por­tée"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Dis­tance de tir en hexa­gones, sans comp­ter ce­lui du ti­reur : une uni­té ad­ja­cente est à 1 hexa­gone."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="In­fan­te­rie : "/>
                <ITEXT CH="1 à 4 hexa­gones."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Ca­va­le­rie : "/>
                <ITEXT CH="1 à 3 hexa­gones."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Pour­suite"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Pour­su"/>
                <ITEXT FONT="Alegreya Sans Bold" KERN="0" CH="ite X] : "/>
                <ITEXT KERN="0" CH="quand l'uni­té, en mê­lée, met sa cible en dé­route ou la fait re­cu­ler, elle peut pour­suivre au lieu d'avan­cer."/>
                <para/>
                <ITEXT CH="Elle se dé­place de 1 à X hexa­gones, en en­trant d'abord dans l'hexa­gone li­bé­ré. Ce dé­pla­ce­ment suit les règles nor­males du Mou­ve­ment : un bois, un gué ou un bâ­ti­ment l'ar­rête."/>
                <para PARENT="Liste numérotée sans suivi"/>
                <ITEXT CH="Elle at­taque une uni­té en­ne­mie ad­ja­cente, la même ou une autre."/>
                <para PARENT="Liste numérotée sans suivi"/>
                <ITEXT CH="L'at­taque de pour­suite est une at­taque com­plète : elle rap­porte du Pou­voir, sa cible peut ri­pos­ter, et l'at­ta­quant peut en­suite avan­cer."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une uni­té ne pour­suit qu'une fois par tour."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="La pour­suite est un choix : l'uni­té peut aus­si avan­cer, ou res­ter sur place."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une ri­poste ne per­met ja­mais de pour­suivre."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Portent "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Pour­suite]"/>
                <ITEXT CH=" d'of­fice : la Ca­va­le­rie de mê­lée lé­gère et stan­dard "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Pour­suite 2]"/>
                <ITEXT CH=", la Ca­va­le­rie de mê­lée lourde "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Pour­suite 1]"/>
                <ITEXT CH=". Les Chars aus­si, se­lon leur classe."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Pou­voir"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Le mot dé­signe trois choses liées."/>
                <para/>
                <ITEXT CH="La face "/>
                <ITEXT Unicode="25" COBJ="20019"/>
                <ITEXT CH=" / "/>
                <ITEXT Unicode="25" COBJ="27345"/>
                <ITEXT CH=" Pou­voir. Elle dé­clenche la règle de l'uni­té qui se dé­clenche sur Pou­voir, comme"/>
                <ITEXT FONT="Alegreya Sans Bold" CH=" [Peur]"/>
                <ITEXT CH=" ou "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Poi­son]"/>
                <ITEXT CH=". Contre une cible em­poi­son­née, elle touche aus­si (voir "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Poi­son"/>
                <ITEXT CH="). Si­non, elle ne fait rien. Sur un jet d'[Ar­mure], elle an­nule une touche."/>
                <para/>
                <ITEXT CH="Le je­ton de Pou­voir  "/>
                <ITEXT Unicode="25" COBJ="16383"/>
                <ITEXT CH=" "/>
                <ITEXT Unicode="25" COBJ="10834"/>
                <ITEXT CH=". Chaque face Pou­voir ob­te­nue quand vous at­ta­quez rap­porte 1 je­ton à la ré­serve de votre camp, que la face dé­clenche une règle ou non."/>
                <para/>
                <ITEXT CH="On compte les faces Pou­voir après les re­lances : un Pou­voir re­lan­cé ne rap­porte rien, un dé re­lan­cé qui donne Pou­voir rap­porte son je­ton."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="L'at­taque de pour­suite et cha­cune des at­taques don­nées par une carte rap­portent du Pou­voir."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Ne rap­portent rien : les ri­postes, les jets d'[Ar­mure], les jets de Des­tin, et le lan­cer de la carte Cri de guerre."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Vous ne ga­gnez donc du Pou­voir que pen­dant votre propre tour."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="La ré­serve de Pou­voir. "/>
                <ITEXT CH="Chaque camp tient une ré­serve com­mune de je­tons, sans pla­fond : les je­tons non dé­pen­sés se gardent."/>
                <para/>
                <ITEXT CH="Gain : les je­tons des at­taques, plus 2 je­tons à l'étape de Pou­voir, à la fin de chaque tour du camp."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Dé­pense : à l'étape de com­man­de­ment, après avoir joué la ou les cartes, le camp peut ac­ti­ver des uni­tés sup­plé­men­taires. Cha­cune coûte au­tant de je­tons qu'elle lance de dés : "/>
                <ITEXT Unicode="25" COBJ="4464"/>
                <ITEXT CH=" 2, "/>
                <ITEXT Unicode="25" COBJ="28013"/>
                <ITEXT CH=" 3, "/>
                <ITEXT Unicode="25" COBJ="22604"/>
                <ITEXT CH=" 4."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Un camp achète ain­si 2 uni­tés au plus par tour ; en Mode mul­ti-joueurs, 2 au plus par joueur, cha­cun dans sa propre Sec­tion."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une uni­té ache­tée ne peut pas être une uni­té dé­jà ac­ti­vée par la carte."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Pro­fil"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Fiche d'une uni­té, dans le li­vret Fac­tions. Il donne son "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Type"/>
                <ITEXT CH=", sa "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Classe"/>
                <ITEXT CH=" et son "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Mode"/>
                <ITEXT CH=", son coût, ses badges et, pour quelques pièces uniques, ses règles propres. En jeu, le je­ton classe/mode suf­fit : on ne rouvre le pro­fil que pour une règle par­ti­cu­lière."/>
                <para/>
                <ITEXT CH="Pro­tec­tion"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Pro­tec­tion] :"/>
                <ITEXT CH=" l'uni­té ignore 1 touche à chaque at­taque qu'elle su­bit."/>
                <para/>
                <ITEXT CH="Elle s'ap­plique avant l'[Ar­mure], qui ne se lance que sur les touches qui res­tent."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Elle vaut contre la mê­lée comme contre le tir."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Elle ne s'ap­plique pas aux pertes d'une re­traite blo­quée."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Elle n'est pas cu­mu­lable : deux sources n'en font igno­rer qu'une."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une uni­té dans un Bâ­ti­ment gagne "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Pro­tec­tion]."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="PV"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Points de vie. Chaque fi­gu­rine d'In­fan­te­rie ou de Ca­va­le­rie vaut 1 PV. Un Char ou une Créa­ture a un comp­teur de PV. Chaque Touche re­tire 1 fi­gu­rine ou 1 PV."/>
                <para/>
                <ITEXT CH="Râ­te­lier"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="En for­mat "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Épique"/>
                <ITEXT CH=", ran­gée de 3 cartes de com­man­de­ment po­sées face vi­sible à cô­té de la pioche, com­munes aux deux camps. Avant le pre­mier tour, re­tour­nez-y les 3 pre­mières cartes de la pioche."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Jouer :"/>
                <ITEXT CH=" un camp peut y prendre 1 carte de sec­tion, en plus de 1 carte de sec­tion de sa main, ou y prendre sa seule carte Tac­tique du tour."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Re­pio­cher :"/>
                <ITEXT CH=" à l'étape de pioche, chaque carte jouée est rem­pla­cée là d'où elle vient. Une carte prise au râ­te­lier est rem­pla­cée par la pre­mière carte de la pioche ; la main du camp ne change pas."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" KERN="-1" CH="Va­leur de com­man­de­ment : "/>
                <ITEXT KERN="-1" CH="les cartes du râ­te­lier n'y comptent ja­mais, même celle que vous jouez."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Éclai­reur pris au râ­te­lier : "/>
                <ITEXT CH="au lieu de re­tour­ner 1 carte, re­tour­nez-en 2 ; pla­cez-en une dans le râ­te­lier et dé­faus­sez l'autre."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Râ­te­lier en­tiè­re­ment Tac­tique : "/>
                <ITEXT CH="si, une fois re­cons­ti­tué, le râ­te­lier ne compte que des cartes Tac­tiques, dé­faus­sez ses 3 cartes et re­tour­nez-en 3 nou­velles. Re­com­men­cez jus­qu'à ce qu'il compte au moins une carte de sec­tion."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Pioche vide : "/>
                <ITEXT CH="mé­lan­gez la dé­fausse pour for­mer une nou­velle pioche."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Re­lance"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Re­lance X] :"/>
                <ITEXT CH=" après le lan­cer, l'uni­té peut re­lan­cer jus­qu'à X dés de son choix, en at­taque comme en ri­poste. Chaque dé n'est re­lan­cé qu'une fois, et on garde le nou­veau ré­sul­tat."/>
                <para/>
                <ITEXT CH="Les re­lances se font avant de comp­ter touches et Dra­peaux."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Les je­tons de Pou­voir se comptent sur le ré­sul­tat fi­nal (voir "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Pou­voir"/>
                <ITEXT CH=")."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="[Re­lance] ne s'ap­plique pas aux jets d'[Ar­mure] ni de Des­tin."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Re­traite"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Chaque "/>
                <ITEXT Unicode="25" COBJ="31586"/>
                <ITEXT CH=" Dra­peau fait re­cu­ler la cible sur­vi­vante de 1 hexa­gone. La re­traite se ré­sout après les pertes."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Di­rec­tion. "/>
                <ITEXT CH="C'est le camp de l'uni­té qui la dé­place. À chaque hexa­gone, il choi­sit un hexa­gone ad­ja­cent libre, stric­te­ment plus proche de son bord que ce­lui qu'elle quitte. D'où que vienne l'at­taque, une uni­té re­cule tou­jours vers son bord. S'il a le choix entre plu­sieurs hexa­gones, il choi­sit li­bre­ment."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Ter­rain. "/>
                <ITEXT CH="Le ter­rain ne gêne pas une uni­té qui re­cule : elle tra­verse bois, gués, col­lines, ponts et bâ­ti­ments sans s'ar­rê­ter. Seul le cours d'eau l'ar­rête."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Re­traite blo­quée. "/>
                <ITEXT KERN="-1" CH="Quand au­cun hexa­gone libre ne rap­proche l'uni­té de son bord, parce que le bord, un cours d'eau ou d'autres uni­tés, amies comme en­ne­mies, lui barrent la route, sa re­traite est blo­quée. Elle perd 1 fi­gu­rine, ou 1 PV, par hexa­gone qu'elle n'a pas pu par­"/>
                <ITEXT CH="cou­rir."/>
                <para/>
                <ITEXT CH="Ni l'"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Ar­mure]"/>
                <ITEXT CH=" ni la "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Pro­tec­tion]"/>
                <ITEXT CH=" ne sauvent ces pertes."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une uni­té dé­jà sur son propre bord a sa re­traite blo­quée dès le pre­mier Dra­peau."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une uni­té peut par­cou­rir une par­tie de sa re­traite, puis être blo­quée : elle ne perd que pour les hexa­gones res­tants."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Ces pertes peuvent mettre l'uni­té en dé­route. L'at­ta­quant marque alors son point de vic­toire, et un Lea­der tente son Des­tin comme d'ha­bi­tude."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une uni­té dont la re­traite a été blo­quée n'a pas bou­gé : si elle sur­vit, elle peut ri­pos­ter."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Cas par­ti­cu­liers."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="En­cer­clée :"/>
                <ITEXT CH=" une uni­té en­tou­rée au point qu'au­cun hexa­gone ne la rap­proche de son bord su­bit toute sa re­traite en pertes."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Sources mul­tiples :"/>
                <ITEXT CH=" les Dra­peaux des dés et ceux d'une règle comme [Peur] s'ad­di­tionnent. [In­ébran­lable] s'ap­plique au to­tal."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Mer­ce­naire] : "/>
                <ITEXT CH="chaque Dra­peau fait re­cu­ler de 2 hexa­gones (voir Mer­ce­naire)."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Chan­ger de Sec­tion en re­cu­lant :"/>
                <ITEXT CH=" l'uni­té passe au joueur de sa nou­velle Sec­tion au tour sui­vant (voir Contrôle d'une uni­té)."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Après la re­traite : "/>
                <ITEXT CH="l'uni­té qui a re­cu­lé ne ri­poste pas, sauf "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Fé­ro­ci­té]"/>
                <ITEXT CH=". L'at­ta­quant de mê­lée peut avan­cer ou pour­suivre."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Ri­poste"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Une fois les pertes et la re­traite ré­glées, la cible d'une at­taque peut ri­pos­ter si elle rem­plit trois condi­tions :"/>
                <para/>
                <ITEXT CH="elle est ad­ja­cente à l'at­ta­quant ;"/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="elle n'a pas bou­gé ;"/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="elle n'est pas en dé­route."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Elle at­taque alors son as­saillant avec tous ses dés, comme pour une at­taque nor­male : ter­rain, faces, règles sur Pou­voir, [Ar­mure] et re­traite s'ap­pliquent."/>
                <para/>
                <ITEXT CH="Une uni­té de tir ri­poste aus­si, puis­qu'elle peut ti­rer sur une uni­té ad­ja­cente."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une uni­té dont la re­traite a été blo­quée n'a pas bou­gé : si elle sur­vit, elle peut ri­pos­ter."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une ri­poste ne rap­porte pas de Pou­voir."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="L'uni­té qui ri­poste ne peut ni avan­cer, ni pour­suivre, ni dé­cro­cher avec [Mo­bi­li­té]."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="On ne ri­poste ja­mais à une ri­poste."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="La ri­poste est un choix : la cible peut y re­non­cer."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Ex­cep­tions :"/>
                <ITEXT CH=" "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Fé­ro­ci­té]"/>
                <ITEXT CH=" per­met de ri­pos­ter avant de re­cu­ler ; on ne ri­poste pas contre une uni­té qui porte "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Vi­gi­lant]"/>
                <ITEXT CH=" ; une uni­té en po­si­tion dé­fen­sive ("/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Dis­ci­pline de co­horte]"/>
                <ITEXT CH=") ne ri­poste pas."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Sec­tion"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Deux lignes dé­coupent le champ de ba­taille en trois Sec­tions : Gauche, Centre et Droite. Les cartes de sec­tion s'y ré­fèrent."/>
                <para/>
                <ITEXT CH="Chaque camp nomme ses Sec­tions de­puis son propre bord : votre Gauche est à votre gauche quand vous re­gar­dez le champ de ba­taille de­puis votre bord. Elle fait face à la Droite de l'ad­ver­saire."/>
                <para PARENT="Liste à puce"/>
                <ITEXT KERN="-1" CH="Une uni­té ap­par­tient à la Sec­tion où elle se trouve. Les Sec­tions n'ont au­cun ef­fet sur le mou­ve­ment."/>
                <para PARENT="Liste à puce"/>
                <ITEXT KERN="-1" CH="Voir aus­si "/>
                <ITEXT FONT="Alegreya Sans Italic" KERN="-1" CH="Hexa­gone de fron­tière, Contrôle d'une uni­té."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Ter­rain"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Un hexa­gone peut por­ter du ter­rain : Bois, Col­line, Cours d'eau, Gué, Pont ou Bâ­ti­ment. Un hexa­gone sans ter­rain est une Plaine. Le scé­na­rio in­dique où le pla­cer. Ta­bleau ré­ca­pi­tu­la­tif en fin de li­vret."/>
                <para/>
                <ITEXT CH="Touche"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Chaque touche re­tire 1 fi­gu­rine d'une uni­té, ou 1 PV du comp­teur d'un Char ou d'une Créa­ture, quelle que soit la cible. Une uni­té ne perd ja­mais plus que ce qu'il lui reste."/>
                <para/>
                <ITEXT CH="Tour"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Le tour d'un seul camp. Il suit tou­jours sept étapes, en deux phases."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Phase prin­ci­pale"/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Com­man­de­ment :"/>
                <ITEXT CH=" jouer sa ou ses cartes, puis dé­pen­ser éven­tuel­le­ment du Pou­voir (voir "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Com­man­de­ment"/>
                <ITEXT CH=")."/>
                <para PARENT="Liste numérotée sans suivi"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Ordre : "/>
                <ITEXT CH="dé­si­gner les uni­tés ac­ti­vées."/>
                <para PARENT="Liste numérotée"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Mou­ve­ment :"/>
                <ITEXT CH=" dé­pla­cer les uni­tés ac­ti­vées, une à une (voir Mou­ve­ment)."/>
                <para PARENT="Liste numérotée"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="At­taque :"/>
                <ITEXT CH=" les uni­tés ac­ti­vées at­taquent, une à une (voir At­taque)."/>
                <para PARENT="Liste numérotée"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Phase de bi­lan"/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Points de vic­toire : "/>
                <ITEXT CH="comp­ter les ob­jec­tifs d'oc­cu­pa­tion (voir Ob­jec­tif)."/>
                <para PARENT="Liste numérotée"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Pioche :"/>
                <ITEXT CH=" dé­faus­ser les cartes jouées et les rem­pla­cer (voir Main, Râ­te­lier)."/>
                <para PARENT="Liste numérotée"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Pou­voir : "/>
                <ITEXT CH="ajou­ter 2 je­tons à la ré­serve du camp."/>
                <para PARENT="Liste numérotée"/>
                <ITEXT CH="Type"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Le type d'une uni­té vient de son pro­fil."/>
                <para/>
                <ITEXT CH="Un pro­fil peut dé­ro­ger à la com­po­si­tion. Le type, la classe et le mode donnent à l'uni­té des règles d'of­fice, qui ne sont pas écrites sur son pro­fil :"/>
                <para/>
                <ITEXT CH="Un Char lit la ligne de la Ca­va­le­rie de son mode. Un pro­fil ne rap­pelle l'une de ces règles que s'il va au-de­là."/>
                <para/>
                <ITEXT CH="Uni­té"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Groupe de fi­gu­rines qui oc­cupent le même hexa­gone et agissent en­semble : c'est elle qu'on ac­tive, qu'on dé­place, qui at­taque et qui su­bit des touches. Un Char ou une Créa­ture forme une uni­té à lui seul."/>
                <para/>
                <ITEXT CH="Va­leur de com­man­de­ment"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Nom"/>
                <ITEXT KERN="-1" CH="bre de cartes que votre camp a en main quand vous jouez, carte jouée com­prise. Beau­coup de cartes ac­tivent « au­tant d'uni­tés que votre va­leur de com­man­de­ment »."/>
                <para/>
                <ITEXT KERN="0" CH="En Épique, les cartes du râ­te­lier n'y comptent ja­mais, même celle que vous jouez. Une carte prise au râ­te­lier se cal­cule donc sur le nombre de cartes en main."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Quand vous jouez 2 cartes de sec­tion, dont une de votre main, celle-ci compte dans la va­leur."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Vic­toire"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Chaque scé­na­rio fixe ses condi­tions de vic­toire. Sauf in­di­ca­tion contraire :"/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" KERN="-1" CH="chaque uni­té en­ne­mie mise en dé­route"/>
                <ITEXT KERN="-1" CH=" rap­porte 1 point de vic­toire, dès qu'elle est re­ti­rée ;"/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="les ob­jec­tifs"/>
                <ITEXT CH=" du scé­na­rio rap­portent aus­si des points (voir "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Ob­jec­tif"/>
                <ITEXT CH=") ;"/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="dès qu'un camp at­teint le score "/>
                <ITEXT CH="fixé par le scé­na­rio, il gagne la par­tie, même au mi­lieu d'un tour."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Cer­tains scé­na­rios s'écartent de ce mo­dèle, par exemple en s'ar­rê­tant sur une li­mite de temps."/>
                <para/>
                <ITEXT CH="Vi­gi­lant"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Vi­gi­lant] :"/>
                <ITEXT CH=" la cible d'une at­taque de cette uni­té ne peut pas ri­pos­ter, quelle que soit l'is­sue de l'at­taque, en mê­lée comme au tir."/>
                <para/>
                <ITEXT CH="Vol"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Vol X] :"/>
                <ITEXT CH=" à son ac­ti­va­tion, l'uni­té peut se dé­pla­cer jus­qu'à X hexa­gones en sur­vo­lant tout ce qui se trouve sur son tra­jet : uni­tés, amies ou en­ne­mies, et ter­rain, cours d'eau com­pris."/>
                <para/>
                <ITEXT CH="Elle ter­mine son dé­pla­ce­ment sur un hexa­gone libre, ja­mais dans un cours d'eau."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Le ter­rain où elle s'ar­rête s'ap­plique nor­ma­le­ment au com­bat."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Elle peut at­ta­quer après son vol, quelle que soit sa classe."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Vol]"/>
                <ITEXT CH=" ne change rien à la re­traite : l'uni­té re­cule comme toute autre."/>
                <trail PARENT="Liste à puce"/>
            </StoryText>
