        <PAGEOBJECT XPOS="737.79627559055" YPOS="7562.67816633861" OwnPage="16" ItemID="828171456" PTYPE="4" WIDTH="481.889999999984" HEIGHT="48.1889763779528" FRTYPE="0" CLIPEDIT="0" PWIDTH="1.00000049019604" PCOLOR="Vert clair" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="2.83464566929134" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L481.89 0 L481.89 48.189 L0 48.189 L0 0 Z" copath="M0 0 L481.89 0 L481.89 48.189 L0 48.189 L0 0 Z" gXpos="0" gYpos="102.047244094488" gWidth="481.889763779528" gHeight="68.0314960629894" PSTYLE="Ligne tableau impair" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Ligne tableau impair">
                    <Tabs Type="0" Pos="45.3543307086614" Fill=""/>
                    <Tabs Type="0" Pos="104.88188976378" Fill=""/>
                    <Tabs Type="0" Pos="189.92125984252" Fill=""/>
