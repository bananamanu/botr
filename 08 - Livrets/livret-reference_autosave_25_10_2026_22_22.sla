            <StoryText>
                <DefaultStyle PARENT="Exemple"/>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="Exemple"/>
                <para PARENT="Exemple"/>
                <ITEXT CH="Des Ar­chers du Ha­rad por­tant [Poi­son] tirent sur des Guer­riers de Mi­nas Ti­rith : Arc, Pou­voir. Une touche, et les Guer­riers sont em­poi­son­nés. Au tour sui­vant, des Lan­ciers du Ha­rad sans [Poi­son] les at­taquent : Épée, Pou­voir, Dra­peau. Deux touches, car la cible est em­poi­son­née."/>
                <trail PARENT="Exemple"/>
            </StoryText>
        </PAGEOBJECT>
