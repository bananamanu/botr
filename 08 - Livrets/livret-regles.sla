        <PAGEOBJECT XPOS="170.867141732283" YPOS="972.756905511811" OwnPage="1" ItemID="212357792" PTYPE="4" WIDTH="481.89" HEIGHT="680.315" FRTYPE="3" CLIPEDIT="1" PWIDTH="1" PLINEART="1" TEXTFLOWMODE="2" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="14.1732283464567" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L481.89 0 L481.89 56.6929 L246.614 56.6929 L246.614 99.2126 L481.89 99.2126 L481.89 141.194 L243.78 141.194 L243.78 200.902 L481.89 200.902 L481.89 261.78 L242.874 261.78 L242.874 324.121 L481.89 324.121 L481.89 358.365 L241.996 358.365 L241.996 418.072 L480.336 418.072 L480.336 634.961 L244.629 634.961 L244.629 680.315 L232.91 680.315 L232.91 555.048 L0 555.048 L0 0 Z" copath="M0 0 L481.89 0 L481.89 680.315 L0 680.315 L0 0 Z" gXpos="170.867141732283" gYpos="972.756905511811" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="265719840" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="1. Le jeu en un coup d'œil "/>
                <para PARENT="Titre 1"/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Ba­tailles de la Terre du Mi­lieu"/>
                <ITEXT CH=" est un jeu de pla­teau avec fi­gu­rines qui vous fait re­jouer les grandes ba­tailles du Sei­gneur des An­neaux. Deux camps s'af­frontent, le Bien et le Mal, sur un champ de ba­taille dé­cou­pé en hexa­gones. Chaque camp est me­né par un à trois joueurs."/>
                <para/>
                <ITEXT CH="Votre ar­mée ne fait pas tout ce que vous vou­lez. À votre tour, vous jouez une carte de com­man­de­ment : elle dé­signe les uni­tés que vous pou­vez ac­ti­ver. Ces uni­tés se dé­placent, puis com­battent, et des jets de dés dé­ter­minent l'is­sue des af­fron­te­ments. Puis c'est au tour du camp ad­verse."/>
                <para/>
                <ITEXT CH="Com­ment ga­gner"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Chaque scé­na­rio a ses propres condi­tions de vic­toire. En gé­né­ral, chaque uni­té en­ne­mie mise en dé­route rap­porte 1 point de vic­toire, et le pre­mier camp à at­teindre le score fixé par le scé­na­rio est dé­cla­ré vain­queur (cha­pitre 4). "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Le li­vret de scé­na­rio "/>
                <ITEXT CH="in­dique ce dont vou sa­vez be­soin pour chaque ba­taille. Voi­ci ce que vous y trou­ve­rez :"/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="le champ de ba­taille"/>
                <ITEXT CH=", un ta­pis d'hexa­gones, et par­fois des élé­ments de ter­rain ;"/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="les fi­gu­rines"/>
                <ITEXT CH=" des peuples en­ga­gés ; "/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="les je­tons classe/mode"/>
                <ITEXT CH=", un par uni­té, qui in­diquent com­ment elle com­bat et se dé­place (cha­pitre 3) ; "/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="les je­tons de badge d'uni­té"/>
                <ITEXT CH=" et les "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="comp­teurs de PV"/>
                <ITEXT CH=" ;"/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="le deck de com­man­de­ment"/>
                <ITEXT CH=", fait de cartes de Sec­tion et de cartes Tac­tiques ; "/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="les dés"/>
                <ITEXT CH=", un jeu par camp ; "/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="les je­tons de Pou­voir"/>
                <ITEXT CH=" "/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="les mé­dailles ob­jec­tif. "/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Les dés"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Chaque dé a six faces : "/>
                <ITEXT Unicode="25" COBJ="5477"/>
                <ITEXT CH=" Épées croi­sées, "/>
                <ITEXT Unicode="25" COBJ="23687"/>
                <ITEXT CH=" Épée, "/>
                <ITEXT Unicode="25" COBJ="26800"/>
                <ITEXT CH=" Arc, "/>
                <ITEXT Unicode="25" COBJ="19457"/>
                <ITEXT CH=" Dra­peau, "/>
                <ITEXT Unicode="25" COBJ="29745"/>
                <ITEXT CH=" Cou­ronne et "/>
                <ITEXT Unicode="25" COBJ="18208"/>
                <ITEXT CH="/ "/>
                <ITEXT Unicode="25" COBJ="8487"/>
                <ITEXT CH=" Pou­voir. Le cha­pitre 7 dit ce que fait cha­cune. Chaque camp lance ses propres dés. Ils ne dif­fèrent que par le sym­bole de la face Pou­voir : la Rune de Gan­dalf sur les dés du Bien, l'Œil de Sau­ron sur ceux du Mal. C'est la même face, avec le même ef­fet. "/>
                <para/>
                <ITEXT CH="Les je­tons de Pou­voir de chaque camp portent le même sym­bole que ses dés. "/>
                <para/>
                <ITEXT CH="Trois for­mats de jeu"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Chaque scé­na­rio se joue dans l'un des trois for­mats du jeu. Le for­mat fixe la taille du champ de ba­taille, et avec elle l'am­pleur de l'af­fron­te­ment : le nombre d'uni­tés en­ga­gées, le nombre de Gé­né­raux qu'un camp peut ali­gner (cha­pitre 9) et le nombre de joueurs au­tour de la table."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="For­mat es­car­mouche :"/>
                <ITEXT CH=" se joue sur un champ de ba­taille de 10 × 7 hexa­gones et re­pré­sente un en­ga­ge­ment ra­pide entre deux avant-gardes"/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="For­mat nor­mal :"/>
                <ITEXT CH=" le for­mat de ré­fé­rence, sur un pla­teau de 13 × 9 hexa­gones et si­mule une ba­taille ran­gée"/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="For­mat épique : "/>
                <ITEXT CH="se joue sur un champ de ba­taille de 17 × 13 hexa­gones et per­met de re­jouer les grandes ba­tailles ico­niques du Sei­gneur des An­neaux, jus­qu'à trois joueurs par camp (cha­pitre 10)"/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Vos quatre li­vrets"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Le li­vret de règles"/>
                <ITEXT CH=", ce­lui-ci. Li­sez-le une fois, du dé­but à la fin : vous n'au­rez pas à le rou­vrir en jouant."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" KERN="0" CH="Le li­vret de ré­fé­rence"/>
                <ITEXT KERN="0" CH=", à gar­der sur la table. Les règles entre cro­chets, comme "/>
                <ITEXT FONT="Alegreya Sans Bold" KERN="0" CH="[Ar­mure]"/>
                <ITEXT KERN="0" CH=" ou "/>
                <ITEXT FONT="Alegreya Sans Bold" KERN="0" CH="[Fé­ro­ci­té]"/>
                <ITEXT KERN="0" CH=", y sont clas­sées par ordre al­pha­bé­tique, avec les cas par­ti­cu­liers et le texte des cartes."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Le li­vret Fac­tions"/>
                <ITEXT CH=", un cha­pitre par peuple : le pro­fil et le coût de chaque uni­té."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Le li­vret de scé­na­rio :"/>
                <ITEXT CH=" la ba­taille, sa mise en place et ses règles propres. "/>
                <para PARENT="Liste à puce"/>
                <ITEXT KERN="-3" CH="2. Le champ de ba­taille"/>
                <para PARENT="Titre 1"/>
                <ITEXT CH="Les hexa­gones"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Le champ de ba­taille est dé­cou­pé en hexa­gones. Une uni­té oc­cupe tou­jours un hexa­gone en­tier, et un hexa­gone n'ac­cueille ja­mais qu'une seule uni­té. Les rares pièces qui en couvrent plu­sieurs le pré­cisent sur leur pro­fil. "/>
                <para/>
                <ITEXT CH="Deux hexa­gones qui par­tagent un cô­té sont ad­ja­cents : chaque hexa­gone a six voi­sins, sauf au bord du champ de ba­taille. Toutes les dis­tances se comptent en hexa­gones."/>
                <para/>
                <ITEXT CH="Les bords"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Chaque camp a son bord : le bord du champ de ba­taille de son cô­té. Le scé­na­rio dé­ploie votre ar­mée de ce cô­té, et vos uni­tés re­culent tou­jours vers lui (cha­pitre 7). "/>
                <para/>
                <ITEXT CH="Les Sec­tions"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Deux lignes dé­coupent le champ de ba­taille en trois Sec­tions : Gauche, Centre et Droite. Les cartes de com­man­de­ment s'y ré­fèrent : une carte « "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="At­taque Gauche"/>
                <ITEXT CH=" » ac­tive des uni­tés de votre Sec­tion Gauche (cha­pitre 5)."/>
                <para/>
                <ITEXT CH="Chaque camp nomme ses Sec­tions de­puis son propre bord. Votre Gauche est à votre gauche quand vous re­gar­dez le champ de ba­taille de­puis votre bord. Elle fait donc face à la Droite de l'ad­ver­saire. "/>
                <para/>
                <ITEXT CH="Les hexa­gones de fron­tière"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Une ligne de Sec­tion peut cou­per des hexa­gones en deux au lieu de suivre leurs cô­tés. Un hexa­gone ain­si cou­pé ap­par­tient aux deux Sec­tions voi­sines : une carte de l'une comme de l'autre peut ac­ti­ver l'uni­té qui s'y trouve. Quand un camp compte plu­sieurs joueurs, cha­cun des deux joueurs des Sec­tions voi­sines peut donc l'ac­ti­ver. Mais, comme toute uni­té, elle ne peut être ac­ti­vée qu'une seule fois par tour."/>
                <para/>
                <ITEXT CH="Le ter­rain"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Cer­tains hexa­gones portent du ter­rain : bois, col­lines, cours d'eau, gués, ponts ou bâ­ti­ments. Le ter­rain freine le mou­ve­ment et in­flue sur le com­bat (cha­pitre 8). Le scé­na­rio in­dique où le 4 pla­cer ; un hexa­gone sans ter­rain est une plaine. "/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="3.  caractéristiques d'une unité"/>
                <para PARENT="Titre 1"/>
                <ITEXT CH="Une unité est un groupe de figurines qui occupent le même hexagone et agissent ensemble. C'est la pièce de base du jeu : c'est elle que vous activez, elle qui se déplace, attaque et subit des touches."/>
                <para/>
                <ITEXT CH="Le profil"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Chaque unité a un profil, dans le livret Factions. Il donne ses trois caractéristiques : son "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="type"/>
                <ITEXT CH=", sa "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="classe"/>
                <ITEXT CH=" et son "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="mode"/>
                <ITEXT CH=". Il indique aussi son coût, ses badges et, pour quelques pièces uniques, des règles propres. "/>
                <para/>
                <ITEXT CH="Le type"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="La classe"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="La classe donne le nombre de dés que l'unité lance quand elle attaque."/>
                <para/>
                <ITEXT CH="Le mode"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Le mode donne la façon de combattre de l'unité, et donc les faces qui touchent quand elle attaque ; "/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Mêlée"/>
                <ITEXT CH=" : l'unité combat au corps à corps. Elle touche sur "/>
                <ITEXT Unicode="25" COBJ="3270"/>
                <ITEXT CH=" Épées croisées et "/>
                <ITEXT Unicode="25" COBJ="13618"/>
                <ITEXT CH=" Épée."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Distance"/>
                <ITEXT CH=" : l'unité tire. Elle touche sur "/>
                <ITEXT Unicode="25" COBJ="30883"/>
                <ITEXT CH=" Arc."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Le jeton classe/mode"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Sur le champ de bataille, un jeton posé à côté de chaque unité rappelle sa classe et son mode. Sa couleur donne la classe, son symbole le mode. Ce symbole est celui de la face de dé qui compte : des épées croisées pour la mêlée, un arc pour le tir. Vous n'avez donc pas besoin du profil en cours de partie pour savoir combien de dés lance une unité et sur quelles faces elle touche."/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Les points de vie"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Chaque touche retire une figurine de l'unité, ou 1 PV du compteur d'un Char ou d'une Créature. Quand elle perd sa dernière figurine, ou son dernier PV, elle est en déroute : retirez- la, l'adversaire marque 1 point de victoire."/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Une unité d'Infanterie ou de Cavalerie réduite à une seule figurine est Faible : elle combat moins bien (chapitre 7)."/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Le mouvement"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="La classe et le type d'une unité fixent de combien d'hexagones elle peut se déplacer quand elle est activée."/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="Infanterie"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="4C9900" CH="Légère"/>
                <tab/>
                <ITEXT CH="2 cases, puis attaque"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="Green Blue" CH="Standard"/>
                <tab/>
                <ITEXT CH="2 cases puis attaque"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="RVB #c50203" CH="Lourde"/>
                <tab/>
                <ITEXT CH="1 puis attaque, ou 2 sans attaquer"/>
                <para PARENT="Default Paragraph Style" ALIGN="0">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="Cavalerie"/>
                <para PARENT="Default Paragraph Style" ALIGN="0"/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="4C9900" CH="Légère"/>
                <tab/>
                <ITEXT CH="4 cases, puis attaque"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="Green Blue" CH="Standard"/>
                <tab/>
                <ITEXT CH="3 cases puis attaque"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="RVB #c50203" CH="Lourde"/>
                <tab/>
                <ITEXT CH="2 puis attaque, ou 3 sans attaquer"/>
                <para PARENT="Default Paragraph Style" ALIGN="0">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT CH="Plus une unité frappe fort, moins elle est mobile : une unité rouge doit choisir entre avancer et frapper. Une unité peut toujours se déplacer de moins, ou rester sur place. Les Chars se déplacent comme une unité de Cavalerie et, sauf mention contraire, les Créatures comme une unité d'Infanterie. Certaines unités ont un mouvement propre, indiqué sur leur profil. Le chapitre 6 explique comment se déplacer. "/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Les règles que l'unité porte d'office"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Certaines règles découlent directement du type, de la classe et du mode. L'unité les porte d'office, sans qu'elles soient écrites sur son profil : on les dit intrinsèques. Un Char lit la ligne de la Cavalerie de son mode."/>
                <para PARENT="Default Paragraph Style" ALIGN="3">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="Infanterie - Mélée"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="4C9900" CH="Légère"/>
                <tab/>
                <ITEXT CH="—"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="Green Blue" CH="Standard"/>
                <tab FONT="Alegreya Sans Bold" FCOLOR="RVB #c50203"/>
                <ITEXT CH="—"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="RVB #c50203" CH="Lourde"/>
                <tab/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Armure]"/>
                <para PARENT="Default Paragraph Style" ALIGN="0">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="Infanterie - Distance"/>
                <ITEXT CH=" "/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="4C9900" CH="Légère"/>
                <tab/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Mobilité 1]"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="Green Blue" CH="Standard"/>
                <tab FONT="Alegreya Sans Bold" FCOLOR="RVB #c50203"/>
                <ITEXT CH="—"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="RVB #c50203" CH="Lourde"/>
                <tab/>
                <ITEXT CH="n'existe pas"/>
                <para PARENT="Default Paragraph Style" ALIGN="0">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="Cavalerie - Mélée"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="4C9900" CH="Légère"/>
                <tab/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Poursuite 2]"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="Green Blue" CH="Standard"/>
                <tab FONT="Alegreya Sans Bold" FCOLOR="RVB #c50203"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Poursuite 2]"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="RVB #c50203" CH="Lourde"/>
                <tab/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Poursuite 1] [Armure]"/>
                <para PARENT="Default Paragraph Style" ALIGN="0">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="Cavalerie - Distance"/>
                <ITEXT CH=" "/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="4C9900" CH="Légère"/>
                <tab/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Mobilité]"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="Green Blue" CH="Standard"/>
                <tab FONT="Alegreya Sans Bold" FCOLOR="RVB #c50203"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Mobilité 1]"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="RVB #c50203" CH="Lourde"/>
                <tab/>
                <ITEXT CH="n'existe pas"/>
                <para PARENT="Default Paragraph Style" ALIGN="0">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="Créature"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Armure]"/>
                <ITEXT CH=" et "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Peur 1]"/>
                <ITEXT CH=", quelle que soit sa classe"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Quatre idées suffisent à retenir le tableau :"/>
                <para PARENT="Default Paragraph Style" ALIGN="0">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT FONT="Alegreya Sans Bold" KERN="-1" CH="Les unités rouges représentent l'élite armurée."/>
                <ITEXT KERN="-1" CH=" Toute unité lourde, à pied comme à cheval, porte "/>
                <ITEXT FONT="Alegreya Sans Bold" KERN="-1" CH="[Armure]"/>
                <ITEXT KERN="-1" CH=" : elle peut annuler des touches (chapitre 7)."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="La cavalerie de mêlée poursuit."/>
                <ITEXT CH=" Après avoir fait reculer son adversaire ou l'avoir mis en déroute, elle peut s'élancer et frapper encore ("/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Poursuite]"/>
                <ITEXT CH=", chapitre 7). La légère et la standard vont plus loin que la lourde."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Le tireur léger ou monté décroche."/>
                <ITEXT CH=" Après avoir tiré, il peut se déplacer ("/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Mobilité]"/>
                <ITEXT CH=", chapitre 6). L'archer à pied standard, lui, reste planté."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="La Créature est armurée et fait peur. Elle porte "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Armure]"/>
                <ITEXT CH=" et "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Peur 1] "/>
                <ITEXT CH=": ses faces Pouvoir font reculer l'ennemi (chapitre 7)."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Un profil ne rappelle l'une de ces règles que s'il va au-delà, par exemple "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Peur 2]. "/>
                <para PARENT="Default Paragraph Style" ALIGN="0">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT CH="Badges et bannière"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Un badge donne une règle de plus à une unité. Il est matérialisé par un jeton de badge d'unité, posé à côté d'elle."/>
                <para PARENT="Default Paragraph Style" ALIGN="0">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT FONT="Alegreya Sans Bold" CH="Leader :"/>
                <ITEXT CH=" un Leader mène l'unité. Il la rend plus dangereuse et affermit ses voisins (chapitre 9)."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Faction :"/>
                <ITEXT CH=" l'unité a une règle propre, indiquée sur son profil et définie dans le livret de référence."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une unité peut aussi compter une figurine avec bannière. Ce n'est pas un badge, mais l'unité y gagne "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Inébranlable 1]"/>
                <ITEXT CH=" : elle peut ignorer 1 "/>
                <ITEXT Unicode="25" COBJ="30968"/>
                <ITEXT CH="  à chaque attaque qu'elle subit (chapitre 7). Cette figurine est retirée en dernier, juste avant un éventuel Leader ; sans elle, l’unité perd cet avantage."/>
                <para PARENT="Default Paragraph Style" ALIGN="0">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT CH="Quelques pièces uniques, comme les Mûmakil ou la Compagnie Grise, ont des règles bien à elles : ce sont des signatures, écrites en entier sur leur profil dans le livret Factions."/>
                <para PARENT="Default Paragraph Style" ALIGN="0">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT CH="4. Le tour de jeu"/>
                <para PARENT="Titre 1"/>
                <ITEXT CH="Les deux camps jouent chacun à leur tour. Un tour est celui d'un seul camp ; une manche compte un tour de chaque camp. Le scénario indique le camp qui ouvre chaque manche."/>
                <para/>
                <ITEXT CH="Votre tour suit toujours le même ordre : sept étapes, réparties en deux phases."/>
                <para/>
                <ITEXT CH="La phase principale"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Commandement."/>
                <ITEXT CH=" Jouez une carte de votre main, face visible (chapitre 5). Vous pouvez ensuite dépenser des jetons de Pouvoir pour activer des unités supplémentaires."/>
                <para PARENT="Liste numérotée"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Ordre. "/>
                <ITEXT CH="Désignez vos unités activées, une à une : celles que la carte permet d'activer, et celles que vous avez payées. Une unité n'est jamais activée deux fois dans le même tour. Une unité non activée ne bouge pas et ne combat pas."/>
                <para PARENT="Liste numérotée"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Mouvement. "/>
                <ITEXT CH="Déplacez vos unités activées, dans l'ordre de votre choix (chapitre 6). Chacune termine son déplacement avant que la suivante commence. Une unité peut rester sur place."/>
                <para PARENT="Liste numérotée"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Attaque."/>
                <ITEXT CH=" Vos unités activées attaquent, dans l'ordre de votre choix (chapitre 7). Une unité peut renoncer à attaquer."/>
                <para PARENT="Liste numérotée"/>
                <ITEXT CH="Toutes vos unités se déplacent avant que la première attaque. Une unité qui a attaqué ne se déplace plus, sauf si une règle le lui permet."/>
                <para/>
                <ITEXT CH="La phase de bilan"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Points de victoire. "/>
                <ITEXT CH="Comptez les objectifs d'occupation, s'il y en a (voir ci-dessous)."/>
                <para PARENT="Liste numérotée"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Pioche."/>
                <ITEXT CH=" Défaussez la carte jouée et piochez pour compléter votre main. Quand la pioche est vide, mélangez la défausse pour en former une nouvelle."/>
                <para PARENT="Liste numérotée"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Pouvoir. "/>
                <ITEXT CH="Ajoutez 2 jetons de Pouvoir à la réserve de votre camp (chapitre 5)."/>
                <para PARENT="Liste numérotée"/>
                <ITEXT CH="Puis c'est au tour du camp adverse."/>
                <para/>
                <ITEXT CH="Gagner la partie"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Chaque scénario fixe ses conditions de victoire. Sauf indication contraire, elles suivent ces règles :"/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Chaque unité ennemie mise en déroute"/>
                <ITEXT CH=" vous rapporte 1 point de victoire, dès qu'elle est retirée du champ de bataille. Prenez une médaille."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Le scénario peut fixer des objectifs"/>
                <ITEXT CH=" qui rapportent aussi des points. Certains sont acquis une fois pour toutes, comme éliminer une unité précise ; d'autres sont temporaires, comme un objectif d'occupation : à chaque étape des points de victoire, quel que soit le camp qui joue, sa médaille va au camp dont une unité occupe l'hexagone. S'il est vide, elle ne va à personne."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Dès qu'un camp atteint le score fixé par le scénario"/>
                <ITEXT CH=", il gagne la partie, même au milieu d'un tour."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Certains scénarios s'écartent de ce modèle, par exemple en s'arrêtant sur une limite de temps. Le livret de scénario le précise."/>
                <para/>
                <ITEXT CH="5. Commander"/>
                <para PARENT="Titre 1"/>
                <ITEXT CH="À chaque tour, une carte de commandement décide quelles unités agissent. Choisir la bonne carte au bon moment est un élément essentiel du jeu."/>
                <para/>
                <ITEXT CH="La main"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Votre camp tient une main secrète de 4 cartes, plus 1 par Général encore en jeu (chapitre 9). Elle diminue dès qu'il est retiré. Les deux camps piochent dans le même deck de commandement."/>
                <para/>
                <ITEXT CH="Les cartes de section"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Une carte de section active des unités dans une ou plusieurs de vos Sections. Le nombre d'unités est indiqué sur la carte : vous choisissez lesquelles, parmi celles qui se trouvent dans la Section visée."/>
                <para/>
                <ITEXT CH="« Patrouille Gauche » active 2 unités de votre Section Gauche."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="« En avant » active 2 unités dans chacune de vos trois Sections."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une unité sur un hexagone de frontière peut être activée par une carte de l'une ou l'autre de ses Sections (chapitre 2)."/>
                <para/>
                <ITEXT CH="Les cartes Tactiques"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Une carte Tactique active selon un autre critère que la Section : le type (« Charge de cavalerie »), la classe (« Bannières rouges »), le mode (« Pluie de flèches »)… le plus souvent n'importe où sur le champ de bataille. Beaucoup donnent en plus un avantage, comme 1 dé de plus en combat. La carte dit tout ce qu'elle fait ; son texte complet figure aussi dans le livret de référence."/>
                <para/>
                <ITEXT CH="La valeur de commandement"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Beaucoup de cartes activent « autant d'unités que votre valeur de commandement ». C'est le nombre de cartes que vous avez en main quand vous jouez, carte jouée comprise. Plus votre main est grande, plus ces cartes sont fortes."/>
                <para/>
                <ITEXT KERN="-3" CH="Quand la carte ne convient pas"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Vous pouvez toujours ignorer le texte de la carte que vous jouez, et activer à la place 1 unité de votre choix, n'importe où sur le champ de bataille. La carte est défaussée comme d'habitude."/>
                <para/>
                <para/>
                <ITEXT CH="La réserve de Pouvoir"/>
                <para/>
                <ITEXT CH="Chaque camp dispose d'une réserve commune de jetons de Pouvoir. Elle permet d'activer des unités que la carte jouée ne couvre pas."/>
                <para/>
                <para/>
                <ITEXT CH="Gagner du Pouvoir."/>
                <para/>
                <para/>
                <ITEXT CH="Chaque face {DÉ:Pouvoir} Pouvoir obtenue quand vous attaquez vous rapporte 1 jeton, posé aussitôt dans votre réserve, que la face déclenche une règle ou non. Les ripostes, les jets d'[Armure] et les jets de Destin ne rapportent rien."/>
                <para/>
                <ITEXT CH="À l'étape de Pouvoir, votre camp ajoute 2 jetons à sa réserve."/>
                <para/>
                <ITEXT CH="Vous ne gagnez donc du Pouvoir que pendant votre propre tour."/>
                <para/>
                <para/>
                <ITEXT CH="Dépenser du Pouvoir. À l'étape de commandement, après avoir joué votre carte, vous pouvez activer des unités supplémentaires. Chacune coûte autant de jetons qu'elle lance de dés :"/>
                <para/>
                <para/>
                <ITEXT CH="Classe"/>
                <tab/>
                <ITEXT CH="Coût"/>
                <para/>
                <ITEXT CH="{VERT} Légère"/>
                <tab/>
                <ITEXT CH="2 jetons"/>
                <para/>
                <ITEXT CH="{BLEU} Standard"/>
                <tab/>
                <ITEXT CH="3 jetons"/>
                <para/>
                <ITEXT CH="{ROUGE} Lourde"/>
                <tab/>
                <ITEXT CH="4 jetons"/>
                <para/>
                <ITEXT CH="Vous activez ainsi 2 unités au plus par tour. Elles s'ajoutent à celles de la carte."/>
                <para/>
                <ITEXT CH="La réserve n'a pas de plafond : les jetons non dépensés se gardent d'un tour à l'autre."/>
                <para/>
                <ITEXT CH="Quand un camp compte plusieurs joueurs, chacun paie pour les unités de sa propre Section (chapitre 10)."/>
                <para/>
                <ITEXT CH="Exemple — Le Bien joue « Patrouille Droite » et active 2 unités à droite. Sa réserve compte 9 jetons. Il en dépense 4 pour activer aussi les Chevaliers de Dol Amroth {ROUGE}, au Centre, et 2 pour une unité d'archers {VERT} à gauche. Il lui reste 3 jetons pour les tours suivants."/>
                <para/>
                <para/>
                <ITEXT CH="Àretenir — Une unité coûte autant de Pouvoir qu'elle lance de dés."/>
                <para/>
                <para/>
                <para/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
