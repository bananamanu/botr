        <MASTEROBJECT XPOS="170.867141732283" YPOS="48.3474566929134" OwnPage="0" ItemID="209624288" PTYPE="5" WIDTH="481.889763779528" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" PWIDTH="1.41732283464567" PCOLOR2="RVB #374317" PLINEART="1" path="" OnMasterPage="Normal gauche" gXpos="45411.812023622" gYpos="378328111.339199" gWidth="0" gHeight="0" LAYER="0"/>
        <MASTEROBJECT XPOS="100.001" YPOS="20.001" OwnPage="2" ItemID="209612960" PTYPE="2" WIDTH="595.275590551181" HEIGHT="841.889763779528" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.24003048006096" LOCALSCY="0.239991380780937" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="0" Pagenumber="0" PFILE="../06 - Images/charte/fond_parchemin_A4_300dpi.png" PRFILE="sRGB display profile (ICC v2.2)" IRENDER="0" EMBEDDED="0" path="M0 0 L595.276 0 L595.276 841.89 L0 841.89 L0 0 Z" copath="M0 0 L595.276 0 L595.276 841.89 L0 841.89 L0 0 Z" OnMasterPage="Page de garde" ImageRes="0" gXpos="44183835.4341007" gYpos="40394098.7411741" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="737.796275590551" YPOS="2736.53643307087" OwnPage="6" ItemID="210946944" PTYPE="4" WIDTH="481.89" HEIGHT="677.48" FRTYPE="3" CLIPEDIT="1" PWIDTH="1" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="14.1732283464567" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L481.89 0 L481.89 677.48 L234.398 677.48 L234.398 350.683 L0 350.683 L0 0 Z" copath="M0 0 L481.89 0 L481.89 677.48 L0 677.48 L0 0 Z" gXpos="737.796275590551" gYpos="2736.53643307087" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="358013856" BACKITEM="210949776"/>
        <PAGEOBJECT XPOS="170.867141732283" YPOS="2736.53643307087" OwnPage="5" ItemID="210949776" PTYPE="4" WIDTH="481.889763779528" HEIGHT="680.314960629921" FRTYPE="3" CLIPEDIT="1" PWIDTH="1" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="14.1732283464567" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L481.89 0 L481.89 680.315 L229.606 680.315 L229.606 651.969 L0 651.969 L0 253.512 L35.1655 253.512 L35.1655 156.927 L0 156.927 L0 0 Z" copath="M0 0 L481.89 0 L481.89 680.315 L0 680.315 L0 0 Z" gXpos="170.867141732283" gYpos="2736.53643307087" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="210946944" BACKITEM="267485312"/>
        <PAGEOBJECT XPOS="746.182678509698" YPOS="249.165354330709" OwnPage="0" ItemID="210954672" PTYPE="4" WIDTH="493.463414634146" HEIGHT="199.317073170732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L493.463 0 L493.463 199.317 L0 199.317 L0 0 Z" copath="M0 0 L493.463 0 L493.463 199.317 L0 199.317 L0 0 Z" gXpos="746.182678509698" gYpos="249.165354330709" gWidth="0" gHeight="0" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
