                <DefaultStyle ALIGN="1" LINESP="55" FONT="Garamond Premier Pro Bold" FONTSIZE="12" FEATURES="inherit smallcaps" FCOLOR="Rich Black"/>
                <ITEXT FONT="Garamond Premier Pro Bold" FONTSIZE="12" FEATURES="inherit smallcaps" FCOLOR="Rich Black" CH="Batailles de la Terre du Milieu - Livret des règles"/>
