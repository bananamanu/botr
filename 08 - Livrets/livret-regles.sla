                <para PARENT="Exemple"/>
                <ITEXT FCOLOR="Black" BGCOLOR="RVB #c69251" CH="Au Pe­len­nor, Ara­gorn dé­barque dans la Sec­tion Gauche du Bien. En face de lui, le Ha­rad et ses Mû­ma­kil tiennent la Sec­tion Droite du Mal. Quand le Mal joue une carte Droite, ce sont eux qui s'ébranlent."/>
                <trail PARENT="Exemple"/>
            </StoryText>
        </PAGEOBJECT>
