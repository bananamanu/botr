        <PAGEOBJECT XPOS="985.827771653543" YPOS="5818.74115748032" OwnPage="12" ItemID="957329072" PTYPE="4" WIDTH="233.858267716535" HEIGHT="119.055118110236" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="RVB #c69251" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="5.66929133858268" BEXTRA="5.66929133858268" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L233.858 0 L233.858 119.055 L0 119.055 L0 0 Z" copath="M0 0 L233.858 0 L233.858 119.055 L0 119.055 L0 0 Z" gXpos="985.827771653543" gYpos="5818.74115748032" gWidth="0" gHeight="0" PSTYLE="Exemple" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Exemple"/>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="Exemple"/>
                <para PARENT="Exemple"/>
                <ITEXT CH="Des Ar­chers de Mi­nas Ti­rith "/>
                <ITEXT Unicode="25" COBJ="783"/>
                <ITEXT CH=" tiennent un bos­quet. Des Gardes ser­pents "/>
                <ITEXT Unicode="25" COBJ="27704"/>
                <ITEXT CH=" les at­taquent : leur cible est dans un bois, ils lancent 2 dés au lieu de 3. Si la carte qui les a ac­ti­vés donne 1 dé de plus en com­bat, ils en lancent 3. Les ar­chers sur­vivent et ri­postent avec leurs 2 dés ha­bi­tuels."/>
                <trail PARENT="Exemple"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="985.827771653543" YPOS="5946.30021259843" OwnPage="12" ItemID="957391376" PTYPE="4" WIDTH="233.858267716535" HEIGHT="59.5275590551181" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="RVB #374317" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="5.66929133858268" BEXTRA="5.66929133858268" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L233.858 0 L233.858 59.5276 L0 59.5276 L0 0 Z" copath="M0 0 L233.858 0 L233.858 59.5276 L0 59.5276 L0 0 Z" gXpos="985.827771653543" gYpos="5946.30021259843" gWidth="0" gHeight="0" PSTYLE="A retenir" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="A retenir"/>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="À re­te­nir"/>
                <para PARENT="A retenir"/>
                <ITEXT CH="Bois, gué et bâ­ti­ment ar­rêtent l'uni­té qui y entre ; bois, col­line et bâ­ti­ment bloquent la vue."/>
                <trail PARENT="A retenir"/>
            </StoryText>
        </PAGEOBJECT>
