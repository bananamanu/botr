                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="À retenir"/>
                <para PARENT="A retenir"/>
                <ITEXT CH="Une unité ne traverse jamais un hexagone occupé et, hormis l'avance et les règles spéciales, aucune unité ne bouge après avoir attaqué."/>
