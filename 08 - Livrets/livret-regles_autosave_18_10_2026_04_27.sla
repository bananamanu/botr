        <PAGEOBJECT XPOS="1014.17422834646" YPOS="3913.22934645669" OwnPage="8" ItemID="430011440" PTYPE="4" WIDTH="233.858267716535" HEIGHT="164.409448818898" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="RVB #c69251" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="5.66929133858268" BEXTRA="5.66929133858268" REXTRA="0" VAlign="1" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L233.858 0 L233.858 164.409 L0 164.409 L0 0 Z" copath="M0 0 L233.858 0 L233.858 164.409 L0 164.409 L0 0 Z" gXpos="1014.17422834646" gYpos="3913.22934645669" gWidth="0" gHeight="0" PSTYLE="Exemple" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Exemple"/>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="Exemple"/>
                <para PARENT="Exemple"/>
                <ITEXT CH="Le Mal active des Archers du Harad "/>
                <ITEXT Unicode="25" COBJ="17229"/>
                <ITEXT CH=". Des Lanciers du Harad, amis, se tiennent devant eux : les archers ne peuvent pas les traverser et les contournent, en 2 hexagones. À l'étape d'attaque, ils tirent sur des Chevaliers de Dol Amroth "/>
                <ITEXT Unicode="25" COBJ="14348"/>
                <ITEXT CH=" à 3 hexagones, puis décrochent de 1 hexagone grâce à "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Mobilité 1]"/>
                <ITEXT CH=". Les voilà à 4 hexagones des Chevaliers. Au tour du Bien, les Chevaliers peuvent les rejoindre en se déplaçant de 3 hexagones, mais ils ne pourront pas attaquer ce tour."/>
                <trail PARENT="Exemple"/>
            </StoryText>
        </PAGEOBJECT>
