            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="746.182678509698" YPOS="249.165354330709" OwnPage="0" ItemID="210957504" PTYPE="4" WIDTH="493.463414634146" HEIGHT="199.317073170732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L493.463 0 L493.463 199.317 L0 199.317 L0 0 Z" copath="M0 0 L493.463 0 L493.463 199.317 L0 199.317 L0 0 Z" gXpos="746.182678509698" gYpos="249.165354330709" gWidth="0" gHeight="0" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="1" LINESP="55" FONT="Garamond Premier Pro Bold" FONTSIZE="50" FEATURES="inherit smallcaps" FCOLOR="White"/>
                <ITEXT FONT="Garamond Premier Pro Bold" FONTSIZE="50" FEATURES="inherit smallcaps" FCOLOR="White" CH="Batailles de la "/>
                <para ALIGN="1" LINESP="55"/>
                <ITEXT FONT="Garamond Premier Pro Bold" FONTSIZE="50" FEATURES="inherit smallcaps" FCOLOR="White" CH="Terre du Milieu"/>
                <trail ALIGN="1" LINESP="55"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="170.867141732283" YPOS="972.756905511811" OwnPage="1" ItemID="212357792" PTYPE="4" WIDTH="481.89" HEIGHT="680.315" FRTYPE="3" CLIPEDIT="1" PWIDTH="1" PLINEART="1" TEXTFLOWMODE="2" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="14.1732283464567" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L481.89 0 L481.89 56.6929 L246.614 56.6929 L246.614 99.2126 L481.89 99.2126 L481.89 141.194 L243.78 141.194 L243.78 200.902 L481.89 200.902 L481.89 261.78 L242.874 261.78 L242.874 324.121 L481.89 324.121 L481.89 358.365 L241.996 358.365 L241.996 418.072 L480.336 418.072 L480.336 634.961 L244.629 634.961 L244.629 680.315 L232.91 680.315 L232.91 555.048 L0 555.048 L0 0 Z" copath="M0 0 L481.89 0 L481.89 680.315 L0 680.315 L0 0 Z" gXpos="170.867141732283" gYpos="972.756905511811" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="265719840" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="1. Le jeu en un coup d'œil "/>
                <para PARENT="Titre 1"/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Ba­tailles de la Terre du Mi­lieu"/>
                <ITEXT CH=" est un jeu de pla­teau avec fi­gu­rines qui vous fait re­jouer les grandes ba­tailles du Sei­gneur des An­neaux. Deux camps s'af­frontent, le Bien et le Mal, sur un champ de ba­taille dé­cou­pé en hexa­gones. Chaque camp est me­né par un à trois joueurs."/>
                <para/>
                <ITEXT CH="Votre ar­mée ne fait pas tout ce que vous vou­lez. À votre tour, vous jouez une carte de com­man­de­ment : elle dé­signe les uni­tés que vous pou­vez ac­ti­ver. Ces uni­tés se dé­placent, puis com­battent, et des jets de dés dé­ter­minent l'is­sue des af­fron­te­ments. Puis c'est au tour du camp ad­verse."/>
                <para/>
                <ITEXT CH="Com­ment ga­gner"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Chaque scé­na­rio a ses propres condi­tions de vic­toire. En gé­né­ral, chaque uni­té en­ne­mie mise en dé­route rap­porte 1 point de vic­toire, et le pre­mier camp à at­teindre le score fixé par le scé­na­rio est dé­cla­ré vain­queur (cha­pitre 4). "/>
                <ITEXT FONT="Alegreya Sans Italic" CH="Le li­vret de scé­na­rio "/>
                <ITEXT CH="in­dique ce dont vou sa­vez be­soin pour chaque ba­taille. Voi­ci ce que vous y trou­ve­rez :"/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="le champ de ba­taille"/>
                <ITEXT CH=", un ta­pis d'hexa­gones, et par­fois des élé­ments de ter­rain ;"/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="les fi­gu­rines"/>
                <ITEXT CH=" des peuples en­ga­gés ; "/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="les je­tons classe/mode"/>
                <ITEXT CH=", un par uni­té, qui in­diquent com­ment elle com­bat et se dé­place (cha­pitre 3) ; "/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="les je­tons de badge d'uni­té"/>
                <ITEXT CH=" et les "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="comp­teurs de PV"/>
                <ITEXT CH=" ;"/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="le deck de com­man­de­ment"/>
                <ITEXT CH=", fait de cartes de Sec­tion et de cartes Tac­tiques ; "/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="les dés"/>
                <ITEXT CH=", un jeu par camp ; "/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="les je­tons de Pou­voir"/>
                <ITEXT CH=" "/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="les mé­dailles ob­jec­tif. "/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Les dés"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Chaque dé a six faces : "/>
                <ITEXT Unicode="25" COBJ="8372"/>
                <ITEXT CH=" Épées croi­sées, "/>
                <ITEXT Unicode="25" COBJ="31505"/>
                <ITEXT CH=" Épée, "/>
                <ITEXT Unicode="25" COBJ="5800"/>
                <ITEXT CH=" Arc, "/>
                <ITEXT Unicode="25" COBJ="22163"/>
                <ITEXT CH=" Dra­peau, "/>
                <ITEXT Unicode="25" COBJ="24772"/>
                <ITEXT CH=" Cou­ronne et "/>
                <ITEXT Unicode="25" COBJ="12807"/>
                <ITEXT CH="/ "/>
                <ITEXT Unicode="25" COBJ="19494"/>
                <ITEXT CH=" Pou­voir. Le cha­pitre 7 dit ce que fait cha­cune. Chaque camp lance ses propres dés. Ils ne dif­fèrent que par le sym­bole de la face Pou­voir : la Rune de Gan­dalf sur les dés du Bien, l'Œil de Sau­ron sur ceux du Mal. C'est la même face, avec le même ef­fet. "/>
                <para/>
                <ITEXT CH="Les je­tons de Pou­voir de chaque camp portent le même sym­bole que ses dés. "/>
                <para/>
                <ITEXT CH="Trois for­mats de jeu"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Chaque scé­na­rio se joue dans l'un des trois for­mats du jeu. Le for­mat fixe la taille du champ de ba­taille, et avec elle l'am­pleur de l'af­fron­te­ment : le nombre d'uni­tés en­ga­gées, le nombre de Gé­né­raux qu'un camp peut ali­gner (cha­pitre 9) et le nombre de joueurs au­tour de la table."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="For­mat es­car­mouche :"/>
                <ITEXT CH=" se joue sur un champ de ba­taille de 10 × 7 hexa­gones et re­pré­sente un en­ga­ge­ment ra­pide entre deux avant-gardes"/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="For­mat nor­mal :"/>
                <ITEXT CH=" le for­mat de ré­fé­rence, sur un pla­teau de 13 × 9 hexa­gones et si­mule une ba­taille ran­gée"/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="For­mat épique : "/>
                <ITEXT CH="se joue sur un champ de ba­taille de 17 × 13 hexa­gones et per­met de re­jouer les grandes ba­tailles ico­niques du Sei­gneur des An­neaux, jus­qu'à trois joueurs par camp (cha­pitre 10)"/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Vos quatre li­vrets"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Le li­vret de règles"/>
                <ITEXT CH=", ce­lui-ci. Li­sez-le une fois, du dé­but à la fin : vous n'au­rez pas à le rou­vrir en jouant."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" KERN="0" CH="Le li­vret de ré­fé­rence"/>
                <ITEXT KERN="0" CH=", à gar­der sur la table. Les règles entre cro­chets, comme "/>
                <ITEXT FONT="Alegreya Sans Bold" KERN="0" CH="[Ar­mure]"/>
                <ITEXT KERN="0" CH=" ou "/>
                <ITEXT FONT="Alegreya Sans Bold" KERN="0" CH="[Fé­ro­ci­té]"/>
                <ITEXT KERN="0" CH=", y sont clas­sées par ordre al­pha­bé­tique, avec les cas par­ti­cu­liers et le texte des cartes."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Le li­vret Fac­tions"/>
                <ITEXT CH=", un cha­pitre par peuple : le pro­fil et le coût de chaque uni­té."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Le li­vret de scé­na­rio :"/>
                <ITEXT CH=" la ba­taille, sa mise en place et ses règles propres. "/>
                <para PARENT="Liste à puce"/>
                <ITEXT KERN="-3" CH="2. Le champ de ba­taille"/>
                <para PARENT="Titre 1"/>
                <ITEXT CH="Les hexa­gones"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Le champ de ba­taille est dé­cou­pé en hexa­gones. Une uni­té oc­cupe tou­jours un hexa­gone en­tier, et un hexa­gone n'ac­cueille ja­mais qu'une seule uni­té. Les rares pièces qui en couvrent plu­sieurs le pré­cisent sur leur pro­fil. "/>
                <para/>
                <ITEXT CH="Deux hexa­gones qui par­tagent un cô­té sont ad­ja­cents : chaque hexa­gone a six voi­sins, sauf au bord du champ de ba­taille. Toutes les dis­tances se comptent en hexa­gones."/>
                <para/>
                <ITEXT CH="Les bords"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Chaque camp a son bord : le bord du champ de ba­taille de son cô­té. Le scé­na­rio dé­ploie votre ar­mée de ce cô­té, et vos uni­tés re­culent tou­jours vers lui (cha­pitre 7). "/>
                <para/>
                <ITEXT CH="Les Sec­tions"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Deux lignes dé­coupent le champ de ba­taille en trois Sec­tions : Gauche, Centre et Droite. Les cartes de com­man­de­ment s'y ré­fèrent : une carte « "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="At­taque Gauche"/>
                <ITEXT CH=" » ac­tive des uni­tés de votre Sec­tion Gauche (cha­pitre 5)."/>
                <para/>
                <ITEXT CH="Chaque camp nomme ses Sec­tions de­puis son propre bord. Votre Gauche est à votre gauche quand vous re­gar­dez le champ de ba­taille de­puis votre bord. Elle fait donc face à la Droite de l'ad­ver­saire. "/>
                <para/>
                <ITEXT CH="Les hexa­gones de fron­tière"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Une ligne de Sec­tion peut cou­per des hexa­gones en deux au lieu de suivre leurs cô­tés. Un hexa­gone ain­si cou­pé ap­par­tient aux deux Sec­tions voi­sines : une carte de l'une comme de l'autre peut ac­ti­ver l'uni­té qui s'y trouve. Quand un camp compte plu­sieurs joueurs, cha­cun des deux joueurs des Sec­tions voi­sines peut donc l'ac­ti­ver. Mais, comme toute uni­té, elle ne peut être ac­ti­vée qu'une seule fois par tour."/>
                <para/>
                <ITEXT CH="Le ter­rain"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Cer­tains hexa­gones portent du ter­rain : bois, col­lines, cours d'eau, gués, ponts ou bâ­ti­ments. Le ter­rain freine le mou­ve­ment et in­flue sur le com­bat (cha­pitre 8). Le scé­na­rio in­dique où le 4 pla­cer ; un hexa­gone sans ter­rain est une plaine. "/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="3.  ca­rac­té­ris­tiques d'une uni­té"/>
                <para PARENT="Titre 1"/>
                <ITEXT CH="Une uni­té est un groupe de fi­gu­rines qui oc­cupent le même hexa­gone et agissent en­semble. C'est la pièce de base du jeu : c'est elle que vous ac­ti­vez, elle qui se dé­place, at­taque et su­bit des touches."/>
                <para/>
                <ITEXT CH="Le pro­fil"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Chaque uni­té a un pro­fil, dans le li­vret Fac­tions. Il donne ses trois ca­rac­té­ris­tiques : son "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="type"/>
                <ITEXT CH=", sa "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="classe"/>
                <ITEXT CH=" et son "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="mode"/>
                <ITEXT CH=". Il in­dique aus­si son coût, ses badges et, pour quelques pièces uniques, des règles propres. "/>
                <para/>
                <ITEXT CH="Le type"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="La classe"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="La classe donne le nombre de dés que l'uni­té lance quand elle at­taque."/>
                <para/>
                <ITEXT CH="Le mode"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Le mode donne la fa­çon de com­battre de l'uni­té, et donc les faces qui touchent quand elle at­taque ; "/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Mê­lée"/>
                <ITEXT CH=" : l'uni­té com­bat au corps à corps. Elle touche sur "/>
                <ITEXT Unicode="25" COBJ="3270"/>
                <ITEXT CH=" Épées croi­sées et "/>
                <ITEXT Unicode="25" COBJ="13618"/>
                <ITEXT CH=" Épée."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Dis­tance"/>
                <ITEXT CH=" : l'uni­té tire. Elle touche sur "/>
                <ITEXT Unicode="25" COBJ="30883"/>
                <ITEXT CH=" Arc."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Le je­ton classe/mode"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Sur le champ de ba­taille, un je­ton po­sé à cô­té de chaque uni­té rap­pelle sa classe et son mode. Sa cou­leur donne la classe, son sym­bole le mode. Ce sym­bole est ce­lui de la face de dé qui compte : des épées croi­sées pour la mê­lée, un arc pour le tir. Vous n'avez donc pas be­soin du pro­fil en cours de par­tie pour sa­voir com­bien de dés lance une uni­té et sur quelles faces elle touche."/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Les points de vie"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Chaque touche re­tire une fi­gu­rine de l'uni­té, ou 1 PV du comp­teur d'un Char ou d'une Créa­ture. Quand elle perd sa der­nière fi­gu­rine, ou son der­nier PV, elle est en dé­route : re­ti­rez- la, l'ad­ver­saire marque 1 point de vic­toire."/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Une uni­té d'In­fan­te­rie ou de Ca­va­le­rie ré­duite à une seule fi­gu­rine est Faible : elle com­bat moins bien (cha­pitre 7)."/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Le mou­ve­ment"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="La classe et le type d'une uni­té fixent de com­bien d'hexa­gones elle peut se dé­pla­cer quand elle est ac­ti­vée."/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="In­fan­te­rie"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="4C9900" CH="Lé­gère"/>
                <tab/>
                <ITEXT CH="2 cases, puis at­taque"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="Green Blue" CH="Stan­dard"/>
                <tab/>
                <ITEXT CH="2 cases puis at­taque"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="RVB #c50203" CH="Lourde"/>
                <tab/>
                <ITEXT CH="1 puis at­taque, ou 2 sans at­ta­quer"/>
                <para PARENT="Default Paragraph Style" ALIGN="0">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="Ca­va­le­rie"/>
                <para PARENT="Default Paragraph Style" ALIGN="0"/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="4C9900" CH="Lé­gère"/>
                <tab/>
                <ITEXT CH="4 cases, puis at­taque"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="Green Blue" CH="Stan­dard"/>
                <tab/>
                <ITEXT CH="3 cases puis at­taque"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="RVB #c50203" CH="Lourde"/>
                <tab/>
                <ITEXT CH="2 puis at­taque, ou 3 sans at­ta­quer"/>
                <para PARENT="Default Paragraph Style" ALIGN="0">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT CH="Plus une uni­té frappe fort, moins elle est mo­bile : une uni­té rouge doit choi­sir entre avan­cer et frap­per. Une uni­té peut tou­jours se dé­pla­cer de moins, ou res­ter sur place. Les Chars se dé­placent comme une uni­té de Ca­va­le­rie et, sauf men­tion contraire, les Créa­tures comme une uni­té d'In­fan­te­rie. Cer­taines uni­tés ont un mou­ve­ment propre, in­di­qué sur leur pro­fil. Le cha­pitre 6 ex­plique com­ment se dé­pla­cer. "/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Les règles que l'uni­té porte d'of­fice"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Cer­taines règles dé­coulent di­rec­te­ment du type, de la classe et du mode. L'uni­té les porte d'of­fice, sans qu'elles soient écrites sur son pro­fil : on les dit in­trin­sèques. Un Char lit la ligne de la Ca­va­le­rie de son mode."/>
                <para PARENT="Default Paragraph Style" ALIGN="3">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="In­fan­te­rie - Mé­lée"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="4C9900" CH="Lé­gère"/>
                <tab/>
                <ITEXT CH="—"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="Green Blue" CH="Stan­dard"/>
                <tab FONT="Alegreya Sans Bold" FCOLOR="RVB #c50203"/>
                <ITEXT CH="—"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="RVB #c50203" CH="Lourde"/>
                <tab/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Ar­mure]"/>
                <para PARENT="Default Paragraph Style" ALIGN="0">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="In­fan­te­rie - Dis­tance"/>
                <ITEXT CH=" "/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="4C9900" CH="Lé­gère"/>
                <tab/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Mo­bi­li­té 1]"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="Green Blue" CH="Stan­dard"/>
                <tab FONT="Alegreya Sans Bold" FCOLOR="RVB #c50203"/>
                <ITEXT CH="—"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="RVB #c50203" CH="Lourde"/>
                <tab/>
                <ITEXT CH="n'existe pas"/>
                <para PARENT="Default Paragraph Style" ALIGN="0">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="Ca­va­le­rie - Mé­lée"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="4C9900" CH="Lé­gère"/>
                <tab/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Pour­suite 2]"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="Green Blue" CH="Stan­dard"/>
                <tab FONT="Alegreya Sans Bold" FCOLOR="RVB #c50203"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Pour­suite 2]"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="RVB #c50203" CH="Lourde"/>
                <tab/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Pour­suite 1] [Ar­mure]"/>
                <para PARENT="Default Paragraph Style" ALIGN="0">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="Ca­va­le­rie - Dis­tance"/>
                <ITEXT CH=" "/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="4C9900" CH="Lé­gère"/>
                <tab/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Mo­bi­li­té]"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="Green Blue" CH="Stan­dard"/>
                <tab FONT="Alegreya Sans Bold" FCOLOR="RVB #c50203"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Mo­bi­li­té 1]"/>
                <breakline/>
                <ITEXT FONT="Alegreya Sans Bold" FCOLOR="RVB #c50203" CH="Lourde"/>
                <tab/>
                <ITEXT CH="n'existe pas"/>
                <para PARENT="Default Paragraph Style" ALIGN="0">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="Créa­ture"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Ar­mure]"/>
                <ITEXT CH=" et "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Peur 1]"/>
                <ITEXT CH=", quelle que soit sa classe"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Quatre idées suf­fisent à re­te­nir le ta­bleau :"/>
                <para PARENT="Default Paragraph Style" ALIGN="0">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT FONT="Alegreya Sans Bold" KERN="-1" CH="Les uni­tés rouges re­pré­sentent l'élite ar­mu­rée."/>
                <ITEXT KERN="-1" CH=" Toute uni­té lourde, à pied comme à che­val, porte "/>
                <ITEXT FONT="Alegreya Sans Bold" KERN="-1" CH="[Ar­mure]"/>
                <ITEXT KERN="-1" CH=" : elle peut an­nu­ler des touches (cha­pitre 7)."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="La ca­va­le­rie de mê­lée pour­suit."/>
                <ITEXT CH=" Après avoir fait re­cu­ler son ad­ver­saire ou l'avoir mis en dé­route, elle peut s'élan­cer et frap­per en­core ("/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Pour­suite]"/>
                <ITEXT CH=", cha­pitre 7). La lé­gère et la stan­dard vont plus loin que la lourde."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Le ti­reur lé­ger ou mon­té dé­croche."/>
                <ITEXT CH=" Après avoir ti­ré, il peut se dé­pla­cer ("/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Mo­bi­li­té]"/>
                <ITEXT CH=", cha­pitre 6). L'ar­cher à pied stan­dard, lui, reste plan­té."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="La Créa­ture est ar­mu­rée et fait peur. Elle porte "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Ar­mure]"/>
                <ITEXT CH=" et "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Peur 1] "/>
                <ITEXT CH=": ses faces Pou­voir font re­cu­ler l'en­ne­mi (cha­pitre 7)."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Un pro­fil ne rap­pelle l'une de ces règles que s'il va au-de­là, par exemple "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Peur 2]. "/>
                <para PARENT="Default Paragraph Style" ALIGN="0">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT CH="Badges et ban­nière"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Un badge donne une règle de plus à une uni­té. Il est ma­té­ria­li­sé par un je­ton de badge d'uni­té, po­sé à cô­té d'elle."/>
                <para PARENT="Default Paragraph Style" ALIGN="0">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT FONT="Alegreya Sans Bold" CH="Lea­der :"/>
                <ITEXT CH=" un Lea­der mène l'uni­té. Il la rend plus dan­ge­reuse et af­fer­mit ses voi­sins (cha­pitre 9)."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Fac­tion :"/>
                <ITEXT CH=" l'uni­té a une règle propre, in­di­quée sur son pro­fil et dé­fi­nie dans le li­vret de ré­fé­rence."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une uni­té peut aus­si comp­ter une fi­gu­rine avec ban­nière. Ce n'est pas un badge, mais l'uni­té y gagne "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[In­ébran­lable 1]"/>
                <ITEXT CH=" : elle peut igno­rer 1 "/>
                <ITEXT Unicode="25" COBJ="30968"/>
                <ITEXT CH="  à chaque at­taque qu'elle su­bit (cha­pitre 7). Cette fi­gu­rine est re­ti­rée en der­nier, juste avant un éven­tuel Lea­der ; sans elle, l’uni­té perd cet avan­tage."/>
                <para PARENT="Default Paragraph Style" ALIGN="0">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT CH="Quelques pièces uniques, comme les Mû­ma­kil ou la Com­pa­gnie Grise, ont des règles bien à elles : ce sont des si­gna­tures, écrites en en­tier sur leur pro­fil dans le li­vret Fac­tions."/>
                <para PARENT="Default Paragraph Style" ALIGN="0">
                    <Tabs Type="0" Pos="71.0120867787867" Fill=""/>
                </para>
                <ITEXT CH="4. Le tour de jeu"/>
                <para PARENT="Titre 1"/>
                <ITEXT CH="Les deux camps jouent cha­cun à leur tour. Un tour est ce­lui d'un seul camp ; une manche compte un tour de chaque camp. Le scé­na­rio in­dique le camp qui ouvre chaque manche."/>
                <para/>
                <ITEXT CH="Votre tour suit tou­jours le même ordre : sept étapes, ré­par­ties en deux phases."/>
                <para/>
                <ITEXT CH="La phase prin­ci­pale"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Com­man­de­ment."/>
                <ITEXT CH=" Jouez une carte de votre main, face vi­sible (cha­pitre 5). Vous pou­vez en­suite dé­pen­ser des je­tons de Pou­voir pour ac­ti­ver des uni­tés sup­plé­men­taires."/>
                <para PARENT="Liste numérotée"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Ordre. "/>
                <ITEXT CH="Dé­si­gnez vos uni­tés ac­ti­vées, une à une : celles que la carte per­met d'ac­ti­ver, et celles que vous avez payées. Une uni­té n'est ja­mais ac­ti­vée deux fois dans le même tour. Une uni­té non ac­ti­vée ne bouge pas et ne com­bat pas."/>
                <para PARENT="Liste numérotée"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Mou­ve­ment. "/>
                <ITEXT CH="Dé­pla­cez vos uni­tés ac­ti­vées, dans l'ordre de votre choix (cha­pitre 6). Cha­cune ter­mine son dé­pla­ce­ment avant que la sui­vante com­mence. Une uni­té peut res­ter sur place."/>
                <para PARENT="Liste numérotée"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="At­taque."/>
                <ITEXT CH=" Vos uni­tés ac­ti­vées at­taquent, dans l'ordre de votre choix (cha­pitre 7). Une uni­té peut re­non­cer à at­ta­quer."/>
                <para PARENT="Liste numérotée"/>
                <ITEXT CH="Toutes vos uni­tés se dé­placent avant que la pre­mière at­taque. Une uni­té qui a at­ta­qué ne se dé­place plus, sauf si une règle le lui per­met."/>
                <para/>
                <ITEXT CH="La phase de bi­lan"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Points de vic­toire. "/>
                <ITEXT CH="Comp­tez les ob­jec­tifs d'oc­cu­pa­tion, s'il y en a (voir ci-des­sous)."/>
                <para PARENT="Liste numérotée"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Pioche."/>
                <ITEXT CH=" Dé­faus­sez la carte jouée et pio­chez pour com­plé­ter votre main. Quand la pioche est vide, mé­lan­gez la dé­fausse pour en for­mer une nou­velle."/>
                <para PARENT="Liste numérotée"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Pou­voir. "/>
                <ITEXT CH="Ajou­tez 2 je­tons de Pou­voir à la ré­serve de votre camp (cha­pitre 5)."/>
                <para PARENT="Liste numérotée"/>
                <ITEXT CH="Puis c'est au tour du camp ad­verse."/>
                <para/>
                <ITEXT CH="Ga­gner la par­tie"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Chaque scé­na­rio fixe ses condi­tions de vic­toire. Sauf in­di­ca­tion contraire, elles suivent ces règles :"/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Chaque uni­té en­ne­mie mise en dé­route"/>
                <ITEXT CH=" vous rap­porte 1 point de vic­toire, dès qu'elle est re­ti­rée du champ de ba­taille. Pre­nez une mé­daille."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Le scé­na­rio peut fixer des ob­jec­tifs"/>
                <ITEXT CH=" qui rap­portent aus­si des points. Cer­tains sont ac­quis une fois pour toutes, comme éli­mi­ner une uni­té pré­cise ; d'autres sont tem­po­raires, comme un ob­jec­tif d'oc­cu­pa­tion : à chaque étape des points de vic­toire, quel que soit le camp qui joue, sa mé­daille va au camp dont une uni­té oc­cupe l'hexa­gone. S'il est vide, elle ne va à per­sonne."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Dès qu'un camp at­teint le score fixé par le scé­na­rio"/>
                <ITEXT CH=", il gagne la par­tie, même au mi­lieu d'un tour."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Cer­tains scé­na­rios s'écartent de ce mo­dèle, par exemple en s'ar­rê­tant sur une li­mite de temps. Le li­vret de scé­na­rio le pré­cise."/>
                <para/>
                <ITEXT CH="5. Com­man­der"/>
                <para PARENT="Titre 1"/>
                <ITEXT CH="À chaque tour, une carte de com­man­de­ment dé­cide quelles uni­tés agissent. Choi­sir la bonne carte au bon mo­ment est un élé­ment es­sen­tiel du jeu."/>
                <para/>
                <ITEXT CH="La main"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Votre camp tient une main se­crète de 4 cartes, plus 1 par Gé­né­ral en­core en jeu (cha­pitre 9). Elle di­mi­nue dès qu'il est re­ti­ré. Les deux camps piochent dans le même deck de com­man­de­ment."/>
                <para/>
                <ITEXT CH="Les cartes de sec­tion"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Une carte de sec­tion ac­tive des uni­tés dans une ou plu­sieurs de vos Sec­tions. Le nombre d'uni­tés est in­di­qué sur la carte : vous choi­sis­sez les­quelles, par­mi celles qui se trouvent dans la Sec­tion vi­sée."/>
                <para/>
                <ITEXT CH="« Pa­trouille Gauche » ac­tive 2 uni­tés de votre Sec­tion Gauche."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="« En avant » ac­tive 2 uni­tés dans cha­cune de vos trois Sec­tions."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une uni­té sur un hexa­gone de fron­tière peut être ac­ti­vée par une carte de l'une ou l'autre de ses Sec­tions (cha­pitre 2)."/>
                <para/>
                <ITEXT CH="Les cartes Tac­tiques"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Une carte Tac­tique ac­tive se­lon un autre cri­tère que la Sec­tion : le type (« Charge de ca­va­le­rie »), la classe (« Ban­nières rouges »), le mode (« Pluie de flèches »)… le plus sou­vent n'im­porte où sur le champ de ba­taille. Beau­coup donnent en plus un avan­tage, comme 1 dé de plus en com­bat. La carte dit tout ce qu'elle fait ; son texte com­plet fi­gure aus­si dans le li­vret de ré­fé­rence."/>
                <para/>
                <ITEXT CH="La va­leur de com­man­de­ment"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Beau­coup de cartes ac­tivent « au­tant d'uni­tés que votre va­leur de com­man­de­ment ». C'est le nombre de cartes que vous avez en main quand vous jouez, carte jouée com­prise. Plus votre main est grande, plus ces cartes sont fortes."/>
                <para/>
                <ITEXT KERN="-3" CH="Quand la carte ne convient pas"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Vous pou­vez tou­jours igno­rer le texte de la carte que vous jouez, et ac­ti­ver à la place 1 uni­té de votre choix, n'im­porte où sur le champ de ba­taille. La carte est dé­faus­sée comme d'ha­bi­tude."/>
                <para/>
                <ITEXT CH="La ré­serve de Pou­voir"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Chaque camp dis­pose d'une ré­serve com­mune de je­tons de Pou­voir. Elle per­met d'ac­ti­ver des uni­tés que la carte jouée ne couvre pas."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Ga­gner du Pou­voir."/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Chaque face "/>
                <ITEXT Unicode="25" COBJ="24182"/>
                <ITEXT CH="/"/>
                <ITEXT Unicode="25" COBJ="3179"/>
                <ITEXT CH=" Pou­voir ob­te­nue quand vous at­ta­quez vous rap­porte 1 je­ton, po­sé aus­si­tôt dans votre ré­serve, que la face dé­clenche une règle ou non. Les ri­postes, les jets d'[Ar­mure] et les jets de Des­tin ne rap­portent rien."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="À l'étape de Pou­voir, votre camp ajoute 2 je­tons à sa ré­serve."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Vous ne ga­gnez donc du Pou­voir que pen­dant votre propre tour."/>
                <para/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Dé­pen­ser du Pou­voir."/>
                <ITEXT CH=" À l'étape de com­man­de­ment, après avoir joué votre carte, vous pou­vez ac­ti­ver des uni­tés sup­plé­men­taires. Cha­cune coûte au­tant de je­tons qu'elle lance de dés :"/>
                <para/>
                <ITEXT CH="Vous ac­ti­vez ain­si 2 uni­tés au plus par tour. Elles s'ajoutent à celles de la carte."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="La ré­serve n'a pas de pla­fond : les je­tons non dé­pen­sés se gardent d'un tour à l'autre."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Quand un camp compte plu­sieurs joueurs, cha­cun paie pour les uni­tés de sa propre Sec­tion (cha­pitre 10)."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="6. Le mouvement"/>
                <para PARENT="Titre 1"/>
                <ITEXT CH="Une unité ne bouge que si elle est activée. À l'étape de mouvement, vous déplacez vos unités activées une à une, dans l'ordre de votre choix. Chacune termine son déplacement avant que la suivante commence."/>
                <para/>
                <ITEXT CH="Se déplacer"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Une unité se déplace d'hexagone en hexagone, en passant chaque fois dans un hexagone adjacent. Elle peut aller dans n'importe quelle direction et en changer en chemin. Son type et sa classe fixent de combien d'hexagones elle peut se déplacer (tableau du chapitre 3). Elle peut toujours se déplacer de moins, ou rester sur place."/>
                <para/>
                <ITEXT CH="Bouger ou frapper"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Une unité rouge doit choisir entre avancer et frapper. L'Infanterie rouge qui se déplace de 2 hexagones ne peut plus attaquer ce tour. De même pour la Cavalerie rouge qui se déplace de 3 hexagones. Vous n'avez rien à annoncer : c'est la distance parcourue qui décide."/>
                <para/>
                <ITEXT CH="Ce qui arrête une unité"/>
                <para PARENT="Titre 2"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Les autres unités."/>
                <ITEXT CH=" Un hexagone n'accueille qu'une unité. Une unité ne peut ni entrer dans un hexagone occupé, ni le traverser, que l'unité qui s'y trouve soit amie ou ennemie."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Le bord."/>
                <ITEXT CH=" Une unité ne quitte jamais le champ de bataille."/>
                <para PARENT="Liste à puce"/>
                <ITEXT FONT="Alegreya Sans Bold" CH="Le terrain."/>
                <ITEXT CH=" Certains terrains arrêtent l'unité qui y entre, d'autres lui barrent le passage (chapitre 8)."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Rien d'autre ne gêne le mouvement. Une unité peut passer à côté d'une unité ennemie, et s'arrêter contre elle pour l'attaquer."/>
                <para/>
                <ITEXT CH="Changer de Section"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Les Sections ne servent qu'à l'activation : elles n'ont aucun effet sur le mouvement. Une unité peut donc franchir une ligne de Section. Aux tours suivants, ce sont les cartes de sa nouvelle Section qui l'activent. Quand un camp compte plusieurs joueurs, elle change aussi de joueur (chapitre 10)."/>
                <para/>
                <ITEXT CH="Décrocher : [Mobilité]"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Le tireur léger ou monté frappe, puis se replie. Une unité qui porte "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Mobilité 1]"/>
                <ITEXT CH=" ou "/>
                <ITEXT FONT="Alegreya Sans Bold" CH="[Mobilité 2]"/>
                <ITEXT CH=" peut, juste après avoir attaqué, se déplacer de 1 ou 2 hexagones de plus."/>
                <para/>
                <ITEXT CH="Ce déplacement se fait aussitôt, avant qu'une autre unité attaque."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Il suit toutes les règles de ce chapitre."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Il vaut aussi après un tir sur une unité adjacente."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Une unité qui renonce à attaquer ne peut pas profiter de la règle [Mobilité], pas plus qu'une unité qui riposte pendant le tour adverse."/>
                <para PARENT="Liste à puce"/>
                <ITEXT CH="Les mouvements propres"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Quelques pièces se déplacent à leur façon : le Mûmakil écrase tout sur son passage, le Roi-Sorcier vole au-dessus du champ de bataille. Leur profil l'indique dans le livret Factions. Une carte peut aussi changer le mouvement des unités qu'elle active, comme « Charge de cavalerie » : son texte l'emporte sur les règles énoncées ici."/>
                <para/>
                <ITEXT CH="Les déplacements pendant un combat"/>
                <para PARENT="Titre 2"/>
                <ITEXT CH="Pendant un combat, une unité peut aussi reculer, avancer ou poursuivre. Ces déplacements ont leurs propres règles (chapitre 7)."/>
                <para/>
                <ITEXT CH="7. Le combat"/>
                <para PARENT="Titre 1"/>
                <ITEXT CH="À l'étape d'attaque, chaque unité activée peut attaquer une unité ennemie. Le combat se règle aux dés : selon la façon de combattre de l'unité, chaque face obtenue touche, fait reculer ou est sans effet."/>
                <para PARENT="Default Paragraph Style"/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="174.606271777004" YPOS="1383.62127904744" OwnPage="1" ItemID="209638448" PTYPE="2" WIDTH="229.170731707317" HEIGHT="116.275782600346" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="0.049296" LOCALSCY="0.049296" LOCALX="517.522943517163" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" Pagenumber="0" PFILE="../06 - Images/plans/plateau-normal.png" PRFILE="sRGB display profile (ICC v2.2)" IRENDER="0" EMBEDDED="0" path="M0 0 L229.171 0 L229.171 116.276 L0 116.276 L0 0 Z" copath="M0 0 L229.171 0 L229.171 116.276 L0 116.276 L0 0 Z" gXpos="174.606271777004" gYpos="1383.62127904744" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
