        <PAGEOBJECT XPOS="170.867141732283" YPOS="3158.89863779527" OwnPage="5" ItemID="267510800" PTYPE="4" WIDTH="233.858267716535" HEIGHT="178.582677165354" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="RVB #c69251" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="5.66929133858268" BEXTRA="5.66929133858268" REXTRA="0" VAlign="1" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L233.858 0 L233.858 178.583 L0 178.583 L0 0 Z" copath="M0 0 L233.858 0 L233.858 178.583 L0 178.583 L0 0 Z" gXpos="170.867141732283" gYpos="3158.89863779527" gWidth="0" gHeight="0" PSTYLE="Exemple" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Exemple"/>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="Exemple"/>
                <para PARENT="Exemple"/>
                <ITEXT CH="Le livret Factions décrit les Chevaliers de Dol Amroth comme de la Cavalerie lourde de mêlée. Sur le champ de bataille, leur jeton est rouge, aux épées croisées. Ils lancent 4 dés et touchent sur Épées croisées et Épée. Ils ont 3 PV. Ils se déplacent de 2 hexagones puis attaquent, ou de 3 sans attaquer. Ils portent [Armure] et [Poursuite 1]. En face, les Archers du Harad sont de l'Infanterie légère de distance, au jeton vert à l'arc : 2 dés, touche sur Arc, 4 PV, 2 hexagones puis tir, et [Mobilité 1] pour décrocher. "/>
                <trail PARENT="Exemple"/>
            </StoryText>
        </PAGEOBJECT>
