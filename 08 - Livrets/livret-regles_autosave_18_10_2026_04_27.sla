            <StoryText>
                <DefaultStyle PARENT="Exemple"/>
                <ITEXT FONT="Alegreya Sans Bold" FEATURES="inherit smallcaps" CH="Exemple"/>
                <para PARENT="Exemple"/>
                <ITEXT CH="Le Bien joue « Pa­trouille Droite » et ac­tive 2 uni­tés à droite. Sa ré­serve compte 9 je­tons. Il en dé­pense 4 pour ac­ti­ver aus­si les Che­va­liers de Dol Am­roth "/>
                <ITEXT Unicode="25" COBJ="8632"/>
                <ITEXT CH=", au Centre, et 2 pour une uni­té d'ar­chers "/>
                <ITEXT Unicode="25" COBJ="25149"/>
                <ITEXT CH=" à gauche. Il lui reste 3 je­tons pour les tours sui­vants."/>
                <trail PARENT="Exemple"/>
