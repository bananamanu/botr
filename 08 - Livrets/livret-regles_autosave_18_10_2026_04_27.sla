        <PAGEOBJECT XPOS="169.489188976378" YPOS="1523.44947735192" OwnPage="1" ItemID="209629952" PTYPE="2" WIDTH="115.921960849406" HEIGHT="114.898954703833" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="0.24" LOCALSCY="0.24" LOCALX="31.8770234894413" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" Pagenumber="0" PFILE="../../../Plateau/Battlelore of the Ring/eclaireur_rohan.png" PRFILE="Embedded GIMP built-in sRGB" IRENDER="0" EPROF="Embedded GIMP built-in sRGB" path="M0 0 L115.922 0 L115.922 114.899 L0 114.899 L0 0 Z" copath="M0 0 L115.922 0 L115.922 114.899 L0 114.899 L0 0 Z" ImageRes="0" gXpos="169.489188976378" gYpos="1523.44947735192" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="332.210540755576" YPOS="1525.77265354331" OwnPage="1" ItemID="209635616" PTYPE="2" WIDTH="62.5936088507231" HEIGHT="101.575778512442" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="0.181385318772218" LOCALSCY="0.181385318772218" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="../../../Plateau/Battlelore of the Ring/berserker_uruk_hai.png" PRFILE="Embedded GIMP built-in sRGB" IRENDER="0" EPROF="Embedded GIMP built-in sRGB" path="M0 0 L62.5936 0 L62.5936 101.576 L0 101.576 L0 0 Z" copath="M0 0 L62.5936 0 L62.5936 101.576 L0 101.576 L0 0 Z" ImageRes="0" gXpos="332.210540755576" gYpos="1525.77265354331" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
